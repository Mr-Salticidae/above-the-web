# 依赖与构建产物
node_modules/
dist/
.astro/

# 「AIGC 快讯」Toy 独立包（scripts/build-toy-news.mjs 产物与中间构建目录）
dist-toy-news/
.toy-build/

# 内容源：构建时从 knowledge-base 仓库克隆，不入库
kb-content/

# 「成为 Prompt 大师」系列：构建时从独立仓库克隆并镜像进 public/，不入库
.cache/
public/prompt-master/

# 系统与编辑器噪声
.DS_Store
Thumbs.db
*.log
.env
.env.*
# 但配置模板要进库——服务器首次安装靠它生成 .env
!platform/server/.env.example

# Toy 封面成品（由 scripts/toy-news-poster/make-poster.py 从 base.jpg 生成）
scripts/toy-news-poster/poster.png

# 账号服务的本地数据库（线上在 /var/lib/atw-platform/）
platform/server/data/

# 本地草稿与临时产物暂存区（不入库、不上站）
tmp/
