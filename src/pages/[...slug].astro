---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTitle, getCategory, getTags, getExcerpt, buildBacklinks, href, isIndexNote } from '../lib/notes.mjs';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  const backlinks = buildBacklinks(notes);
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note, backlinks: backlinks.get(note.id) || [] },
  }));
}

const { note, backlinks } = Astro.props;
const { Content } = await render(note);
const title = getTitle(note);
const category = getCategory(note);
const tags = getTags(note);
// kind 让 AI 查询能把栏目索引页排到正文笔记后面（见 src/lib/knowledge-search.mjs）；
// 右上角的普通全文搜索不看这个过滤条件，索引页照样能搜到。
const kind = isIndexNote(note) ? 'index' : 'note';
---

<BaseLayout title={title} description={getExcerpt(note, 120)}>
  <article class="prose" data-pagefind-filter="type:note">
    {/* 一个 data-pagefind-filter 属性只能放一个过滤条件——写成 "type:note, kind:note"
        会被整条当成 type 的值（连 type=note 都匹配不上），所以 kind 另挂一个元素。 */}
    <p class="meta" data-pagefind-meta="category" data-pagefind-filter={`kind:${kind}`}>{category}</p>
    <Content />
    {tags.length > 0 && (
      <div class="tags">
        {tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    )}
  </article>

  {backlinks.length > 0 && (
    <nav class="backlinks">
      <h2>← 链接到这里的笔记</h2>
      <ul>
        {backlinks.map((b) => (
          <li><a href={href(b.slug)}>{b.title}</a></li>
        ))}
      </ul>
    </nav>
  )}
</BaseLayout>
