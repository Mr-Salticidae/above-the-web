---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SpiderWeb from '../components/SpiderWeb.astro';
import { groupNotes } from '../lib/note-groups.mjs';
import { games } from '../data/games.js';
import { getEpisodes, getLatestEpisodes } from '../lib/prompt-master.mjs';
import { getLatestIssue, formatDate } from '../lib/news.mjs';

// base-aware 链接：兼容 GitHub Pages 子路径与自定义域名根路径
const gamesBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const gameHref = (g) => (/^https?:/.test(g.path) ? g.path : gamesBase + g.path);

// 「成为 Prompt 大师」系列：构建时读取同步进 public/ 的画廊数据，首页展示最新几期封面。
const seriesBase = import.meta.env.BASE_URL.replace(/\/$/, '') + '/prompt-master/';
const seriesTotal = getEpisodes().length;
const latestEpisodes = getLatestEpisodes(4);
const coverSrc = (e) => seriesBase + encodeURI(e.folder) + '/' + encodeURI(e.cover);

// 「AIGC 快讯」：首页速览最新一期的头部条目，入口进本站 /news/
const newsBase = import.meta.env.BASE_URL.replace(/\/$/, '') + '/news/';
const latestNews = getLatestIssue();
const newsPeek = latestNews ? latestNews.items.slice(0, 4) : [];

// 「任务书」：对外发布的合作任务，首页速览最新几份，入口进 /tasks/
const tasksBase = import.meta.env.BASE_URL.replace(/\/$/, '') + '/tasks/';
const allTasks = (await getCollection('tasks')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const taskPeek = allTasks.slice(0, 3);
const openTaskCount = allTasks.filter((t) => t.data.status === 'open').length;

// 「笔记」：全部篇目的索引已独立成 /notes/，首页只留栏目入口（每栏篇数 + 一句话定位）
const notesBase = import.meta.env.BASE_URL.replace(/\/$/, '') + '/notes/';
const { groups, total } = groupNotes(await getCollection('notes'));

// 左侧浮动版块索引：首页各版块的锚点目录
const toc = [
  { id: 'top', label: '首页' },
  ...(latestNews ? [{ id: 'news', label: 'AIGC 快讯' }] : []),
  ...(latestEpisodes.length > 0 ? [{ id: 'prompt-master', label: '成为 Prompt 大师' }] : []),
  { id: 'plays', label: '可玩' },
  ...(allTasks.length > 0 ? [{ id: 'tasks', label: '任务书' }] : []),
  { id: 'collab', label: '协作板块' },
  { id: 'notes', label: '笔记' },
];

// 首页板块的杂志式编号刊眉：编号 + 英文标签，随实际存在的板块顺延
const kickers = [];
if (latestNews) kickers.push(['news', 'AIGC Daily']);
if (latestEpisodes.length > 0) kickers.push(['prompt-master', 'Prompt Master']);
kickers.push(['plays', 'Plays']);
if (allTasks.length > 0) kickers.push(['tasks', 'Commissions']);
kickers.push(['collab', 'Collaboration']);
kickers.push(['notes', 'Notes']);
const kickerOf = Object.fromEntries(kickers.map(([id, label], i) => [id, { no: String(i + 1).padStart(2, '0'), label }]));
---

<BaseLayout description="跳蛛先生的个人站——AIGC 创作笔记、每日快讯、prompt 拆解连载，和一些做着玩的小作品。">
  <nav class="toc" id="toc" aria-label="版块索引">
    <ul>
      {toc.map((t) => (
        <li>
          <a class="toc-item" href={`#${t.id}`} data-target={t.id} data-cat={t.cat || ''} title={t.label}>
            <span class="toc-dot"></span>
            <span class="toc-label">{t.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <section class="hero" id="top">
    <SpiderWeb />
    <div class="hero-inner">
      <p class="hero-kicker">跳蛛先生的个人站</p>
      <h1>蛛网之上</h1>
      <p class="hero-sub">
        这里从一份 AIGC 方法论知识库，慢慢长成了现在的样子：每天更新的行业快讯、
        一期期 prompt 拆解连载、几件可以直接上手玩的小作品，
        和 <span class="count-up" id="hero-count" data-target={total}>{total}</span> 篇仍在生长的笔记。
        欢迎随便逛。
      </p>
    </div>
  </section>

  {latestNews && (
    <section class="news-peek" id="news">
      <header class="sec-head">
        <p class="sec-kicker"><i>{kickerOf.news.no}</i>{kickerOf.news.label}</p>
        <h2>AIGC 快讯</h2>
        <p class="sec-desc">每天早晨自动更新的 AIGC 新闻精选——模型发布、工具更新、行业动向，为创作者划重点。宁缺毋滥。</p>
      </header>
      <a class="news-peek-issue" href={newsBase}>
        <span class="np-no">第 {latestNews.no} 期 · {formatDate(latestNews.date)}</span>
        {latestNews.headline && <span class="np-headline">{latestNews.headline}</span>}
      </a>
      <ul class="news-peek-list">
        {newsPeek.map((it) => (
          <li>
            <a href={it.url} target="_blank" rel="noopener">
              <span class="np-cat">{it.category}</span>
              <span class="np-title">{it.title}</span>
              <span class="np-src">{it.source} ↗</span>
            </a>
          </li>
        ))}
      </ul>
      <a class="news-peek-all" href={newsBase}>阅读本期全部 {latestNews.items.length} 条 →</a>
    </section>
  )}

  {latestEpisodes.length > 0 && (
    <section class="series" id="prompt-master">
      <header class="sec-head">
        <p class="sec-kicker"><i>{kickerOf['prompt-master'].no}</i>{kickerOf['prompt-master'].label}</p>
        <h2>成为 Prompt 大师</h2>
        <p class="sec-desc">
          面向 AIGC 小白的 prompt 拆解连载：每期一个 battle 主题，讲清「难在哪 → 怎么破题 → 完整 prompt → 四层拆解」。不追结果，记录过程。
        </p>
      </header>
      <div class="series-grid">
        {latestEpisodes.map((e) => (
          <a class="series-card" href={`${seriesBase}#${e.id}`}>
            <div class="series-cover">
              <img src={coverSrc(e)} alt={e.title} loading="lazy" width="300" height="400" />
            </div>
            <div class="series-meta">
              <span class="series-no">{e.no}</span>
              <h3>{e.title}</h3>
              <p>{e.sub}</p>
            </div>
          </a>
        ))}
        <a class="series-card series-all" href={seriesBase}>
          <div class="series-all-inner">
            <span class="series-all-arrow">→</span>
            <h3>查看全部 {seriesTotal} 期</h3>
            <p>进入完整画廊</p>
          </div>
        </a>
      </div>
    </section>
  )}

  <section class="plays" id="plays">
    <header class="sec-head">
      <p class="sec-kicker"><i>{kickerOf.plays.no}</i>{kickerOf.plays.label}</p>
      <h2>可玩</h2>
      <p class="sec-desc">能在浏览器里直接打开就玩、或免费下载带走的小东西——用 vibe coding 做的作品，国内直连。</p>
    </header>
    <div class="play-grid">
      {games.map((g) => (
        <a class="play-card" href={gameHref(g)} style={`--g-accent:${g.accent}`}>
          <div class="play-badge">{g.emoji}</div>
          <div class="play-body">
            <span class="play-status">{g.status}</span>
            <h3>{g.title}</h3>
            <p class="play-tagline">{g.tagline}</p>
            <p class="play-desc">{g.desc}</p>
            <div class="play-tags">{g.tags.map((t) => <span>{t}</span>)}</div>
            <span class="play-cta">{g.cta ?? '开始游玩 →'}</span>
          </div>
        </a>
      ))}
      <div class="play-card play-soon" aria-hidden="true">
        <div class="play-badge">＋</div>
        <div class="play-body">
          <h3>更多游戏开发中</h3>
          <p class="play-desc">新的 vibe coding 作品会持续发布在这里。</p>
        </div>
      </div>
    </div>
  </section>

  {allTasks.length > 0 && (
    <section class="tasks-peek" id="tasks">
      <header class="sec-head">
        <p class="sec-kicker"><i>{kickerOf.tasks.no}</i>{kickerOf.tasks.label}</p>
        <h2>任务书</h2>
        <p class="sec-desc">对外发布的合作任务：要求、对标素材、时间与报酬一次写清，认领前先读完。{openTaskCount > 0 ? `当前 ${openTaskCount} 份招募中。` : '当前暂无招募，新任务会发布在这里。'}</p>
      </header>
      <ul class="task-peek-list">
        {taskPeek.map((t) => (
          <li>
            <a href={`${tasksBase}${t.id}/`}>
              <span class:list={['tk-status', { 'is-open': t.data.status === 'open' }]}>{t.data.status === 'open' ? '招募中' : t.data.status === 'taken' ? '进行中' : t.data.status === 'done' ? '完工待打款' : '已收官'}</span>
              <span class="tk-title">{t.data.title}</span>
              {t.data.fee && <span class="tk-fee">{t.data.fee}</span>}
              {t.data.deadline && <span class="tk-deadline">截止 {formatDate(t.data.deadline)}</span>}
            </a>
          </li>
        ))}
      </ul>
      <a class="news-peek-all" href={tasksBase}>查看全部 {allTasks.length} 份任务书 →</a>
    </section>
  )}

  <section class="collab" id="collab">
    <header class="sec-head">
      <p class="sec-kicker"><i>{kickerOf.collab.no}</i>{kickerOf.collab.label}</p>
      <h2>协作板块</h2>
      <p class="sec-desc">带学员做项目时用的内部协作空间——镜头看板、进度流转、评审意见都收在一处，不靠群聊翻记录。当前进行中的是第三届瓦卡奖（VACAT）AI 叙事短片带教项目。</p>
    </header>
    <a class="collab-card" href="https://tiaozhuxiansheng.com/vacat/">
      <div class="collab-body">
        <h3>VACAT 2026 · 镜头看板</h3>
        <p>1 位指导 + 2 位首次参赛的学员，35 天做一部 90–120 秒 AI 叙事短片。</p>
        <p class="collab-note">内部项目，需邀请码登录；未登录只能看到登录页。</p>
      </div>
      <span class="collab-cta">进入板块 →</span>
    </a>
  </section>

  <section class="notes-peek" id="notes">
    <header class="sec-head">
      <p class="sec-kicker"><i>{kickerOf.notes.no}</i>{kickerOf.notes.label}</p>
      <h2>笔记</h2>
      <p class="sec-desc">沉淀下来的方法论、模板与档案——按主题分栏，篇篇希望做到可复用。这里是小站最初的样子，目前 {total} 篇。</p>
    </header>
    <div class="note-cats">
      {groups.map((g) => (
        <a class="note-cat" href={`${notesBase}?cat=${encodeURIComponent(g.cat)}`}>
          <span class="nc-count">{g.count} 篇</span>
          <h3>{g.cat}</h3>
          {g.desc && <p>{g.desc}</p>}
        </a>
      ))}
    </div>
    <a class="news-peek-all" href={notesBase}>进入笔记库 · 全部 {total} 篇 →</a>
  </section>
</BaseLayout>

<script>
  import { revealOnScroll } from '../scripts/reveal.js';
  revealOnScroll(
    '.sec-head, .news-peek-issue, .news-peek-list li, .news-peek-all, .series-card, ' +
      '.play-card, .task-peek-list li, .collab-card, .note-cat',
  );
</script>

<script is:inline>
  // 标题数字 count-up（尊重 reduced-motion；后台标签页 rAF 会暂停，此时直接显示最终值）
  const el = document.getElementById('hero-count');
  const target = el ? +el.dataset.target : 0;
  if (el && target && !document.hidden && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const start = performance.now();
    const dur = 900;
    el.textContent = '0';
    const tick = (now) => {
      if (document.hidden) { el.textContent = target.toString(); return; }
      const p = Math.min(1, (now - start) / dur);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = Math.round(eased * target).toString();
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  // 左侧浮动版块索引：点击跳转 + 滚动高亮当前版块
  const tocNav = document.getElementById('toc');
  if (tocNav) {
    const tocItems = [...tocNav.querySelectorAll('.toc-item')];
    tocItems.forEach((it) => {
      it.addEventListener('click', (e) => {
        e.preventDefault();
        const el = document.getElementById(it.dataset.target);
        if (!el) return;
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    // 滚动高亮：当前版块 = 顶端已越过视口 35% 线的最后一个版块（始终恰好一个）。
    // 滚动监听用 capture 阶段挂在 document 上——可捕获 window 或任意容器滚动元素冒发的
    // scroll 事件，跨环境可靠；rAF 节流后用 getBoundingClientRect 精确判定。
    const targets = tocItems
      .map((i) => ({ item: i, el: document.getElementById(i.dataset.target) }))
      .filter((t) => t.el);
    let ticking = false;
    function syncActive() {
      ticking = false;
      const line = window.innerHeight * 0.35;
      let current = targets[0].item;
      for (const t of targets) {
        if (t.el.getBoundingClientRect().top <= line) current = t.item;
      }
      tocItems.forEach((x) => x.classList.toggle('is-active', x === current));
    }
    function onScroll() {
      if (!ticking) { ticking = true; requestAnimationFrame(syncActive); }
    }
    document.addEventListener('scroll', onScroll, { capture: true, passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    syncActive();
  }

</script>

<style>
  /* 左侧浮动版块索引 —— 圆点导航，hover 展开标签，滚动高亮当前版块 */
  .toc {
    position: fixed; left: 1.1rem; top: 50%; transform: translateY(-50%);
    z-index: 40;
  }
  .toc ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .2rem; }
  .toc-item { display: flex; align-items: center; gap: .6rem; padding: .28rem .35rem; color: var(--ink-soft); text-decoration: none; }
  .toc-dot {
    flex: none; width: 8px; height: 8px; border-radius: 50%;
    background: transparent; border: 1.5px solid var(--line);
    transition: background .2s ease, border-color .2s ease, transform .2s ease;
  }
  /* 标签：收起时 0 宽无背景；展开/常驻时浮出独立胶囊背景，保证在正文上可读 */
  .toc-label {
    font-family: var(--sans); font-size: .8rem; line-height: 1; white-space: nowrap;
    max-width: 0; padding: 0; opacity: 0; overflow: hidden;
    background: var(--paper-2); border: 1px solid transparent; border-radius: 999px;
    transition: max-width .28s ease, opacity .2s ease, padding .28s ease;
  }
  /* hover/聚焦整条 → 所有标签滑出（仅此时占用正文一侧空间，属临时浮层） */
  .toc:hover .toc-label, .toc:focus-within .toc-label {
    max-width: 14rem; opacity: 1; padding: .34em .7em; border-color: var(--line);
  }
  .toc-item:hover { color: var(--ink); }
  .toc-item:hover .toc-dot { border-color: var(--accent); }
  /* 当前版块：圆点实心放大指示位置（标签靠 hover 展开，避免常驻挡正文） */
  .toc-item.is-active { color: var(--ink); font-weight: 600; }
  .toc-item.is-active .toc-dot { background: var(--accent); border-color: var(--accent); transform: scale(1.35); }
  @media (prefers-reduced-motion: reduce) { .toc-label, .toc-dot { transition: none; } }
  /* 窄屏没有侧边空间：隐藏浮动索引，交给顶部筛选条 */
  @media (max-width: 1080px) { .toc { display: none; } }

  /* AIGC 快讯 —— 首页速览版块：最新一期头部条目 + 入口 */
  .news-peek { max-width: 72rem; margin: 0 auto; padding: 3.4rem 1.5rem .5rem; }

  .news-peek-issue {
    display: block; padding: 1.1rem 1.3rem; border: 1px solid var(--line); border-radius: 14px 14px 0 0;
    border-bottom: none; background: var(--paper-2); color: var(--ink);
  }
  .news-peek-issue:hover { text-decoration: none; }
  .news-peek-issue:hover .np-headline { color: var(--accent); }
  .np-no { display: block; font-size: .74rem; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); font-variant-numeric: tabular-nums; }
  .np-headline { display: block; margin-top: .35rem; font-family: var(--serif); font-size: 1.15rem; line-height: 1.5; transition: color .15s ease; }

  .news-peek-list { list-style: none; margin: 0; padding: 0; border: 1px solid var(--line); border-radius: 0 0 14px 14px; background: var(--paper-2); overflow: hidden; }
  .news-peek-list li { border-top: 1px solid var(--line); }
  .news-peek-list a {
    display: grid; grid-template-columns: auto 1fr auto; gap: .9rem; align-items: baseline;
    padding: .8rem 1.3rem; color: var(--ink); transition: background .15s ease;
  }
  .news-peek-list a:hover { background: var(--accent-soft); text-decoration: none; }
  .np-cat { font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); white-space: nowrap; }
  .np-title { font-size: .94rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .np-src { font-size: .74rem; color: var(--ink-soft); white-space: nowrap; }
  @media (max-width: 640px) {
    .news-peek-list a { grid-template-columns: auto 1fr; }
    .np-title { white-space: normal; }
    .np-src { display: none; }
  }
  .news-peek-all { display: inline-block; margin-top: .8rem; font-size: .86rem; font-weight: 600; }

  /* 成为 Prompt 大师 —— 旗舰发刊系列，独立版块，展示最新几期封面 */
  .series { max-width: 72rem; margin: 0 auto; padding: 3.4rem 1.5rem .5rem; }

  .series-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(13.5rem, 1fr)); gap: 1rem; }

  .series-card {
    display: flex; flex-direction: column; overflow: hidden; background: var(--paper-2);
    border: 1px solid var(--line); border-radius: 14px; text-decoration: none;
    transition: transform .2s cubic-bezier(.2,.7,.3,1), box-shadow .2s ease, border-color .2s ease;
  }
  .series-card:hover {
    transform: translateY(-4px); text-decoration: none;
    box-shadow: 0 16px 40px -16px rgba(var(--shadow), .5);
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
  }
  .series-cover { aspect-ratio: 3 / 4; overflow: hidden; background: var(--paper-3); }
  .series-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .series-meta { padding: .8rem .9rem 1rem; min-width: 0; }
  .series-no { font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
  .series-card h3 { font-family: var(--serif); font-size: 1.02rem; margin: .25rem 0 .35rem; color: var(--ink); }
  .series-meta p { margin: 0; font-size: .8rem; color: var(--ink-soft); line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  /* 末尾「查看全部」卡 */
  .series-all { align-items: center; justify-content: center; text-align: center; border-style: dashed; }
  .series-all:hover { border-style: dashed; }
  .series-all-inner { padding: 1.5rem 1rem; }
  .series-all-arrow { display: block; font-size: 2rem; line-height: 1; color: var(--accent); margin-bottom: .6rem; }
  .series-all h3 { font-family: var(--serif); font-size: 1.05rem; margin: 0 0 .2rem; color: var(--ink); }
  .series-all p { margin: 0; font-size: .8rem; color: var(--ink-soft); }

  @media (max-width: 480px) { .series-grid { grid-template-columns: repeat(2, 1fr); gap: .75rem; } }

  /* 可玩 · Plays —— 数据驱动的作品入口区，风格沿用站点 token */
  .plays { max-width: 72rem; margin: 0 auto; padding: 3.4rem 1.5rem .5rem; }

  /* 任务书 —— 首页速览版块：目录体条目 + 入口，与快讯速览同构 */
  .tasks-peek { max-width: 72rem; margin: 0 auto; padding: 3.4rem 1.5rem .5rem; }
  .task-peek-list { list-style: none; margin: 0; padding: 0; border: 1px solid var(--line); border-radius: 14px; background: var(--paper-2); overflow: hidden; }
  .task-peek-list li + li { border-top: 1px solid var(--line); }
  .task-peek-list a {
    display: grid; grid-template-columns: auto 1fr auto auto; gap: .9rem; align-items: baseline;
    padding: .85rem 1.3rem; color: var(--ink); transition: background .15s ease;
  }
  .task-peek-list a:hover { background: var(--accent-soft); text-decoration: none; }
  .tk-status {
    font-family: var(--sans); font-size: .64rem; letter-spacing: .12em; text-transform: uppercase;
    border-radius: 999px; padding: .16em .65em; white-space: nowrap;
    color: var(--ink-soft); border: 1px solid var(--line);
  }
  .tk-status.is-open { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); background: var(--accent-soft); }
  .tk-title { font-family: var(--serif); font-size: .96rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
