---
// 半仙 NPC 演绎翻页卡 —— 出逃连体村专用。
// 素材原文本身公开，这里做成纯静态页：拿到链接即可看，无需登录 / 无需 DM 身份。
// 页面 noindex，不进搜索引擎索引；顶部保留软提示，别在玩家面前打开即可。
// 剧透数据是下方 script 里的静态常量，不依赖私库本地路径，构建自包含。
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="半仙演绎卡"
  description="出逃连体村 · 半仙 NPC 演绎复习卡"
  section="juben"
  noindex={true}
>
  <div class="npc-page" id="npc-page">
    <div class="npc-deck" id="npc-deck">
      <header class="npc-head">
        <div class="npc-kicker">出逃连体村 · 解惑大会</div>
        <h1>半仙 NPC 演绎复习卡</h1>
        <p class="npc-intro" id="npc-intro"></p>
        <div class="npc-warn">⚠️ 剧透 · 仅演绎人员阅读，别在玩家面前打开</div>
      </header>
      <div class="npc-bar"><i id="npc-bar"></i></div>
      <div class="npc-meta">
        <span id="npc-counter"></span>
        <div class="npc-dots" id="npc-dots"></div>
      </div>
      <div class="npc-stage" id="npc-stage"></div>
      <div class="npc-nav">
        <button type="button" id="npc-prev">← 上一页</button>
        <button type="button" id="npc-next" class="is-main">下一页 →</button>
      </div>
      <div class="npc-hintkey">点按钮翻页 · 电脑按 ← → · 手机左右滑动 · 圆点可跳页</div>
      <a class="npc-back" href={import.meta.env.BASE_URL + 'juben/'}>← 返回剧本研究室</a>
    </div>
  </div>
</BaseLayout>

<style is:global>
  :root{
    --npc-bg:#faf8f4; --npc-card:#fff; --npc-ink:#2a2520; --npc-sub:#6b6156;
    --npc-line:#e9e2d6; --npc-gold:#a97c28; --npc-goldbg:#fbf3e2;
    --npc-ember:#c8642a; --npc-red:#b5392b; --npc-redbg:#fdf0ee;
    --npc-green:#2f7d5b; --npc-greenbg:#eef7f2;
  }
  .npc-page{max-width:760px;margin:0 auto;padding:28px 16px 60px;min-height:70vh}
  .npc-deck{display:flex;flex-direction:column;min-height:70vh}
  .npc-head{text-align:center;margin-bottom:16px}
  .npc-kicker{color:var(--npc-gold);font-size:12px;letter-spacing:3px;font-weight:700}
  .npc-head h1{font-size:24px;margin:6px 0 8px;letter-spacing:1px;color:var(--npc-ink)}
  .npc-intro{color:var(--npc-sub);font-size:13px;max-width:520px;margin:0 auto}
  .npc-warn{background:var(--npc-redbg);border:1px solid #f0d3ce;color:var(--npc-red);font-size:12px;padding:9px 14px;border-radius:10px;margin-top:14px}
  .npc-bar{height:5px;background:#efe7d8;border-radius:3px;overflow:hidden;margin-bottom:8px}
  .npc-bar > i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--npc-gold),var(--npc-ember));border-radius:3px;transition:width .32s ease}
  .npc-meta{display:flex;justify-content:space-between;align-items:center;font-size:11px;color:var(--npc-sub);margin-bottom:12px}
  .npc-dots{display:flex;gap:6px}
  .npc-dots b{width:7px;height:7px;border-radius:50%;background:#ddd2bf;cursor:pointer;transition:.2s}
  .npc-dots b.on{background:var(--npc-gold);transform:scale(1.35)}
  .npc-dots b.seen{background:#c8ad78}
  .npc-stage{flex:1}
  .npc-page .page{display:none;animation:npc-fade .3s ease}
  .npc-page .page.active{display:block}
  @keyframes npc-fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  .npc-card{background:var(--npc-card);border:1px solid var(--npc-line);border-radius:14px;padding:18px 20px;box-shadow:0 2px 10px rgba(60,45,20,.04)}
  .npc-card h2{font-size:15px;display:flex;align-items:center;gap:9px;margin-bottom:12px;color:var(--npc-ink)}
  .npc-card h2 .n{background:var(--npc-gold);color:#fff;width:22px;height:22px;border-radius:6px;display:inline-flex;align-items:center;justify-content:center;font-size:12px;flex:none}
  .npc-card ul{padding-left:20px}
  .npc-card li{font-size:13.5px;margin:5px 0}
  .npc-card li b,.npc-card p b{color:var(--npc-ember)}
  .npc-steps{counter-reset:s;list-style:none;padding:0}
  .npc-steps li{position:relative;padding-left:34px;margin:8px 0}
  .npc-steps li:before{counter-increment:s;content:counter(s);position:absolute;left:0;top:1px;width:22px;height:22px;border-radius:50%;background:var(--npc-goldbg);color:var(--npc-gold);font-weight:700;font-size:12px;display:flex;align-items:center;justify-content:center}
  .npc-seq{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px;font-size:12px;align-items:center}
  .npc-seq span{background:var(--npc-goldbg);color:var(--npc-gold);padding:4px 9px;border-radius:20px;font-weight:600}
  .npc-seq i{color:var(--npc-sub);font-style:normal}
  .npc-hero{text-align:center;margin-bottom:14px}
  .npc-hero .bigidx{font-size:34px;font-weight:800;color:var(--npc-gold);line-height:1}
  .npc-hero .pname{font-size:19px;font-weight:800;margin-top:4px;color:var(--npc-ink)}
  .npc-hero .ptag{font-size:11px;color:var(--npc-sub)}
  .npc-line{border-radius:12px;padding:13px 15px;margin-bottom:10px;border:1px solid var(--npc-line);background:#fffdf9}
  .npc-line .cap{font-size:11px;color:var(--npc-sub);font-weight:700;letter-spacing:1px;margin-bottom:5px}
  .npc-line.ask .txt{font-size:13.5px;color:var(--npc-ink)}
  .npc-line.ans{background:var(--npc-greenbg);border-color:#cfe7da}
  .npc-line.ans .cap{color:var(--npc-green)}
  .npc-line.ans .txt{font-size:16px;font-weight:700;line-height:1.55;color:var(--npc-ink)}
  .npc-line.ans.mute{background:var(--npc-redbg);border-color:#f0d3ce}
  .npc-line.ans.mute .cap{color:var(--npc-red)}
  .npc-line.ans .lbl{display:inline-block;font-size:11px;font-weight:700;padding:2px 8px;border-radius:5px;margin-bottom:7px;background:#fff;color:var(--npc-green)}
  .npc-line.ans.mute .lbl{color:var(--npc-red)}
  .npc-line.bye .txt{font-size:13.5px;color:var(--npc-sub)}
  .npc-line.bye .txt b{color:var(--npc-ink)}
  .npc-line.bye .txt b:first-child{color:var(--npc-red)}
  .npc-trap{background:var(--npc-redbg);border:1px solid #f0d3ce;color:var(--npc-red);border-radius:10px;padding:10px 13px;font-size:12.5px;font-weight:700;margin-top:2px}
  .npc-dont{background:var(--npc-redbg);border:1px solid #f0d3ce;border-radius:14px;padding:18px 20px}
  .npc-dont h2 .n{background:var(--npc-red)}
  .npc-dont ol{padding-left:22px}
  .npc-dont li{margin:8px 0;color:#7d2a20;font-size:13.5px}
  .npc-dont li b{color:var(--npc-red)}
  .npc-hintbox{background:var(--npc-goldbg);border:1px solid #ecd9ac;border-radius:12px;padding:14px 16px;margin-top:12px}
  .npc-hintbox h3{font-size:13px;color:var(--npc-ember);margin-bottom:6px}
  .npc-hintbox li{font-size:12.5px;color:var(--npc-ink);margin:4px 0}
  .npc-motto{text-align:center;margin-top:12px;padding:14px;background:#2a2520;color:#f3ead9;border-radius:12px;font-size:13px;line-height:1.9}
  .npc-motto b{color:#e3b95a}
  .npc-nav{display:flex;align-items:center;gap:10px;margin-top:16px}
  .npc-nav button{flex:1;font-family:inherit;font-size:14px;font-weight:700;color:var(--npc-ink);background:var(--npc-card);border:1px solid var(--npc-line);border-radius:12px;padding:12px;cursor:pointer;transition:.15s}
  .npc-nav button:hover:not(:disabled){border-color:var(--npc-gold);color:var(--npc-gold)}
  .npc-nav button:active:not(:disabled){transform:scale(.98)}
  .npc-nav button:disabled{opacity:.35;cursor:default}
  .npc-nav button.is-main{background:var(--npc-gold);color:#fff;border-color:var(--npc-gold);flex:2}
  .npc-nav button.is-main:hover:not(:disabled){background:#956d20;color:#fff}
  .npc-hintkey{text-align:center;font-size:10.5px;color:#a99e8e;margin-top:10px}
  .npc-back{display:inline-block;margin:18px auto 0;color:var(--npc-gold);font-size:12px;text-decoration:none}
  @media (max-width:520px){
    .npc-page{padding:20px 14px 48px}
    .npc-head h1{font-size:21px}
    .npc-intro{font-size:12px}
    .npc-hintkey{display:none}
  }
</style>

<script>
  // 剧透数据在构建期随页面一起产出——素材原文公开，拿链接即可看，无需登录。
  const DECK = {
    "intro": "你的全部戏份 = 解惑大会「单独搜证」· 约 15 分钟 · 五位玩家逐个进屋。手机可左右滑动，电脑按 ← → 翻页。",
    "slides": [
      {
        "kind": "section", "no": "0", "title": "你是谁",
        "bullets": [
          "林槑村的**半仙**，全村唯一“通神”的人，**无所不知**。",
          "此番出场：算到自己将死，把十二年一次的解惑会**提前两年**召开。",
          "遮全脸狐仙面具 + 黑袍遮全身；声音压低放慢，20 岁左右女声感。神秘、威严、话少、说一不二。",
          "风格可自由发挥，**但台词与禁忌不能改**。"
        ]
      },
      {
        "kind": "section", "no": "1", "title": "上场前准备",
        "bullets": [
          "狐仙面具 + 袍子、铃铛（摇铃 = 叫下一位）、盒子当魔盒、5 张魔纸线索卡、蜡烛灯 + 昏暗房间 + 桌椅。",
          "BGM《Yin-Yang》（岩崎英则）全程播放。",
          "**关键**：玩家敲门后进屋前，魔盒里**只放这位玩家自己的那张魔纸卡**，别让他看到盒内。"
        ]
      },
      {
        "kind": "steps", "no": "2", "title": "每位玩家都走这六步",
        "steps": [
          "玩家敲门 → 你**摇铃**，玩家进屋",
          "说：**“请坐。”**",
          "说：**“你的问题是什么？”**",
          "玩家口述问题 + 把纸条丢进魔盒（别让他看盒里）",
          "你**沉思片刻** → 说出答案（谁出声谁只对口型，见后面逐人页）",
          "递出该玩家的魔纸卡 → 说 **“你可以离开了。”** → 摇铃叫下一位"
        ],
        "seq": ["① 村医", "② 许一诺", "③ 白沐白笙", "④ 村警", "⑤ 王芜莲"]
      },
      {
        "kind": "person", "idx": "①", "name": "村医 · 李时", "tag": "第 1 位进屋",
        "askLabel": "他会问", "ask": "怎样才能治愈我的心理问题？",
        "answer": "治水宜疏不宜堵，村警两兄弟是你们的命定之人。既然情欲难压，不如顺从本心，与他们坦然相爱。",
        "mute": true, "muteLabel": "🔇 只对口型 · 绝不出声",
        "bye": "<b>对口型</b>“你可以离开了”",
        "trap": "⚠️ 出声就穿帮——这张嘴只动不出音。"
      },
      {
        "kind": "person", "idx": "②", "name": "许一诺 · 外乡人", "tag": "第 2 位进屋",
        "askLabel": "她会问", "ask": "我和周远能安全离开林村吗？",
        "answer": "不能，你们有一个人会死在这里。",
        "mute": false, "muteLabel": "🔊 出声（可发癫、语气吓人）",
        "bye": "<b>“你可以离开了”</b>"
      },
      {
        "kind": "person", "idx": "③", "name": "白沐 · 白笙", "tag": "第 3 位进屋 · 全场最关键",
        "askLabel": "她会问", "ask": "村里有谁知道刘莹魂于何处？别说废话。",
        "answer": "王芜莲。",
        "mute": false, "muteLabel": "🔊 出声",
        "bye": "<b>不能说“你可以离开了”</b>——眼神示意她走即可",
        "trap": "🔑 关键伏笔：这一刻真半仙已被杀，说错那句就毁了后面的推理。"
      },
      {
        "kind": "person", "idx": "④", "name": "村警 · 朱大智", "tag": "第 4 位进屋",
        "askLabel": "他会问", "ask": "村里有没有犯下杀人罪却逃过制裁的人？",
        "answer": "王芜莲。",
        "mute": false, "muteLabel": "🔊 出声",
        "bye": "<b>“你可以离开了”</b>"
      },
      {
        "kind": "person", "idx": "⑤", "name": "王芜莲 · 村花", "tag": "第 5 位 · 最后一位进屋",
        "askLabel": "她会问", "ask": "我这一生，最应该看重的人或事是什么？",
        "answer": "永远保守自已知晓的秘密，不要下头。",
        "mute": true, "muteLabel": "🔇 只对口型 · 绝不出声",
        "bye": "<b>“你可以离开了”</b>",
        "trap": "⚠️ 她已“听不到”答案——只张嘴，不出声。"
      },
      {
        "kind": "redlines", "no": "!", "title": "三个绝不能",
        "items": [
          "<b>村医、王芜莲——只对口型、绝不出声。</b>诡计核心，出声就穿帮。",
          "<b>对白沐——给完卡绝不能说“你可以离开了”。</b>关键伏笔，用眼神示意他走。",
          "<b>魔盒别让玩家看到里面</b>，一次只放一张魔纸卡。"
        ],
        "extraTitle": "可选加戏",
        "extra": [
          "许一诺后，主持人（周远）可能进屋找茬：“在我回答完这个问题的十秒内，我会不会举起右手？” → 你答<b>“会。”</b>",
          "五位玩家都拿卡离场后你的戏份就结束，之后<b>不用再出声</b>。"
        ],
        "motto": "摇铃请坐问问题 → 收纸条给答案 → 递魔纸说“可以离开”<br><b>村医王芜莲不张嘴，白沐不能说“可以离开”。</b>"
      }
    ]
  };
  const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (ch) => (
    { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]
  ));
  // 数据块里只有少数几处刻意用的 <b>/<br> 标记，先转义再放行这两个标签。
  const rich = (value) => escapeHtml(value).replace(/&lt;b&gt;/g, '<b>').replace(/&lt;\/b&gt;/g, '</b>').replace(/&lt;br&gt;/g, '<br>');
  const inline = (value) => escapeHtml(value).replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');

  function slideHtml(s) {
    if (s.kind === 'person') {
      return `<div class="page">
        <div class="npc-hero"><div class="bigidx">${escapeHtml(s.idx)}</div><div class="pname">${escapeHtml(s.name)}</div><div class="ptag">${escapeHtml(s.tag || '')}</div></div>
        <div class="npc-line ask"><div class="cap">${escapeHtml(s.askLabel || 'TA 会问')}</div><div class="txt">${escapeHtml(s.ask)}</div></div>
        <div class="npc-line ans${s.mute ? ' mute' : ''}"><div class="lbl">${escapeHtml(s.muteLabel || '')}</div><div class="txt">${escapeHtml(s.answer)}</div></div>
        <div class="npc-line bye"><div class="cap">告别</div><div class="txt">${rich(s.bye)}</div></div>
        ${s.trap ? `<div class="npc-trap">${escapeHtml(s.trap)}</div>` : ''}
      </div>`;
    }
    if (s.kind === 'steps') {
      return `<div class="page"><div class="npc-card">
        <h2><span class="n">${escapeHtml(s.no)}</span>${escapeHtml(s.title)}</h2>
        <ol class="npc-steps">${s.steps.map((x) => `<li>${inline(x)}</li>`).join('')}</ol>
        <div class="npc-seq">${(s.seq || []).map((x, i) => `${i ? '<i>→</i>' : ''}<span>${escapeHtml(x)}</span>`).join('')}</div>
      </div></div>`;
    }
    if (s.kind === 'redlines') {
      return `<div class="page">
        <div class="npc-dont"><h2><span class="n">${escapeHtml(s.no)}</span>${escapeHtml(s.title)}</h2>
          <ol>${s.items.map((x) => `<li>${rich(x)}</li>`).join('')}</ol>
        </div>
        <div class="npc-hintbox"><h3>${escapeHtml(s.extraTitle || '可选加戏')}</h3><ul>${(s.extra || []).map((x) => `<li>${rich(x)}</li>`).join('')}</ul></div>
        <div class="npc-motto">${rich(s.motto)}</div>
      </div>`;
    }
    // section
    return `<div class="page"><div class="npc-card">
      <h2><span class="n">${escapeHtml(s.no)}</span>${escapeHtml(s.title)}</h2>
      <ul>${s.bullets.map((x) => `<li>${inline(x)}</li>`).join('')}</ul>
    </div></div>`;
  }

  function mount(data) {
    const stage = document.getElementById('npc-stage');
    stage.innerHTML = `<div class="page active"><div class="npc-card" style="text-align:center;padding:32px 20px">
      <div style="font-size:44px;line-height:1">🎭</div>
      <h2 style="justify-content:center;margin:12px 0 6px">点「下一页」开始复习</h2>
      <p style="color:var(--npc-sub);font-size:13px">角色 → 准备 → 流程 → 五位玩家逐个 → 红线</p>
    </div></div>` + data.slides.map(slideHtml).join('');
    document.getElementById('npc-intro').textContent = data.intro || '';
    const pages = Array.from(stage.querySelectorAll('.page'));
    const dotsBox = document.getElementById('npc-dots');
    dotsBox.innerHTML = pages.map(() => '<b></b>').join('');
    const dots = Array.from(dotsBox.children);
    const bar = document.getElementById('npc-bar');
    const counter = document.getElementById('npc-counter');
    const prev = document.getElementById('npc-prev');
    const next = document.getElementById('npc-next');
    let i = 0;
    let maxSeen = 0;

    function render() {
      pages.forEach((p, k) => p.classList.toggle('active', k === i));
      dots.forEach((d, k) => { d.classList.toggle('on', k === i); d.classList.toggle('seen', k < maxSeen && k !== i); });
      bar.style.width = ((i + 1) / pages.length * 100) + '%';
      counter.textContent = `第 ${i + 1} / ${pages.length} 页`;
      prev.disabled = i === 0;
      next.disabled = i === pages.length - 1;
      next.textContent = i === pages.length - 1 ? '已到最后一页' : '下一页 →';
    }
    function go(k) {
      i = Math.max(0, Math.min(pages.length - 1, k));
      if (i > maxSeen) maxSeen = i;
      render();
      stage.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'nearest' });
    }
    dots.forEach((d, k) => d.addEventListener('click', () => go(k)));
    prev.addEventListener('click', () => go(i - 1));
    next.addEventListener('click', () => go(i + 1));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === ' ') { e.preventDefault(); go(i + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(i - 1); }
    });
    let x0 = null;
    stage.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0; x0 = null;
      if (dx < -50) go(i + 1);
      if (dx > 50) go(i - 1);
    }, { passive: true });
    render();
  }

  mount(DECK);
</script>
