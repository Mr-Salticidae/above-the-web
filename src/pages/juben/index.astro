<script>
  // 公开学习区：切卷、筛选、清单勾选、复述自测、复制清单。
  // 进度不再自己管 localStorage——统一交给 progress-store（按账号分桶、老数据迁移），
  // 个人中心的档案库读的是同一个仓库，两边不会各存一份。
  import { createProgressStore, GUEST_OWNER } from '../../scripts/progress-store.js';
  import { createProgressSync, mountBadge, relativeTime } from '../../scripts/progress-sync.js';
  import { PROGRESS_SYNC } from '../../data/features.js';
  import { api, getCachedUser, onAuthChange, url } from '../../scripts/account-core.js';
  import { firstOpenMission, missionAt, missionHref, nextMission } from '../../scripts/juben-journey.js';

  (() => {
    const dataNode = document.getElementById('juben-data');
    if (!dataNode) return;
    const cases = JSON.parse(dataNode.textContent || '[]');
    const byId = new Map(cases.map((item) => [item.id, item]));
    const cards = [...document.querySelectorAll('[data-case]')];
    const filterButtons = [...document.querySelectorAll('[data-filter]')];
    const groupButtons = [...document.querySelectorAll('.juben-compare-filters [data-group]')];
    const search = document.getElementById('juben-search');
    const empty = document.getElementById('juben-empty');
    const result = document.getElementById('juben-result');
    const detail = document.getElementById('juben-detail');
    const moduleList = document.getElementById('module-list');
    let activeFilter = 'all';
    let quizIndex = 0;
    let selectedMissionSlug = '';
    const selfCheckState = new Map();
    const scrollBehavior = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

    function captureFocus() {
      const active = document.activeElement;
      if (!active) return null;
      if (active.id) return { id: active.id };
      return active.dataset?.jubenFocus ? { key: active.dataset.jubenFocus } : null;
    }

    function restoreFocus(snapshot) {
      if (!snapshot) return;
      const target = snapshot.id
        ? document.getElementById(snapshot.id)
        : [...document.querySelectorAll('[data-juben-focus]')].find((node) => node.dataset.jubenFocus === snapshot.key);
      if (target && !target.hidden && !target.disabled) target.focus({ preventScroll: true });
    }

    const store = createProgressStore({ cases, owner: getCachedUser()?.id || GUEST_OWNER });
    store.boot();

    // 复述草稿按账号分桶，只留本机：它可能包含主持笔记甚至剧透，不进公开数据、不上传。
    const DRAFT_KEY = 'atw-juben-training-drafts-v1';
    const draftMemory = new Map();
    const failedDrafts = new Set();
    let draftOwner = store.owner;
    const draftKey = (caseId, slug) => `${draftOwner}/${caseId}/${slug}`;
    function readDrafts() {
      try {
        const value = JSON.parse(localStorage.getItem(DRAFT_KEY) || '{}');
        return value && typeof value === 'object' ? value : {};
      } catch {
        return {};
      }
    }
    function loadDraft(caseId, slug) {
      const key = draftKey(caseId, slug);
      if (draftMemory.has(key)) return draftMemory.get(key);
      return String(readDrafts()[draftOwner]?.[`${caseId}/${slug}`] || '');
    }
    function updateDraftWarning(caseId, slug) {
      const warning = document.getElementById('trainer-draft-warning');
      if (warning) warning.hidden = !failedDrafts.has(draftKey(caseId, slug));
    }
    function saveDraft(caseId, slug, value) {
      const key = draftKey(caseId, slug);
      draftMemory.set(key, value);
      try {
        const drafts = readDrafts();
        const bucket = drafts[draftOwner] && typeof drafts[draftOwner] === 'object' ? drafts[draftOwner] : {};
        const storageKey = `${caseId}/${slug}`;
        if (value.trim()) bucket[storageKey] = value;
        else delete bucket[storageKey];
        drafts[draftOwner] = bucket;
        localStorage.setItem(DRAFT_KEY, JSON.stringify(drafts));
        failedDrafts.delete(key);
        return true;
      } catch {
        failedDrafts.add(key);
        return false;
      }
    }

    // 打开时没指定卷：接着上次读到的那一卷（60 天内的记录，超了就当没读过）。
    // 指定了 ?case= 就完全听链接的——从个人中心点某一卷进来不该被「上次」劫走。
    const RESUME_MAX_AGE = 60 * 24 * 60 * 60_000;
    const askedCase = new URLSearchParams(location.search).get('case');
    const askedModule = new URLSearchParams(location.search).get('module') || '';
    const explicitCase = byId.has(askedCase);
    let selected = askedCase;
    let resumedFrom = null;
    if (!byId.has(selected)) {
      const last = store.lastReading();
      if (last && Date.now() - last.at < RESUME_MAX_AGE) {
        selected = last.caseId;
        resumedFrom = last;
      } else {
        selected = cases[0]?.id;
      }
    }

    // ---------- 跨设备同步 ----------
    // 本地永远先认，网络只是后台对账；徽章常显状态，不弹窗打断。
    let sync = null;
    const badge = document.getElementById('sync-badge');

    // 换设备首开时本机是空的，真正的「上次读到」要等首轮拉取下来才知道。
    // 所以先别急着记位置（否则会用当前默认卷把服务端那条盖掉），拉完再定。
    let spotSettled = false;
    let userPicked = false; // 用户自己点过卷：之后不再自动跳转

    function showResume(spot) {
      const resume = document.getElementById('juben-resume');
      if (!resume) return;
      const title = byId.get(spot.caseId)?.title || '';
      const synced = store.owner !== GUEST_OWNER && sync?.enabled && sync.status().state === 'synced';
      const restoreCopy = synced ? '此账号已同步，换台设备登录也会接上。' : '这条续读记录仅保证保留在本机。';
      resume.innerHTML = `接着上次读：<b>《${title}》</b> · ${relativeTime(spot.at)}。${restoreCopy}`;
      resume.hidden = false;
    }

    function settleSpot(remote = false) {
      if (spotSettled) return;
      spotSettled = true;
      const last = store.lastReading();
      const fresh = last && Date.now() - last.at < RESUME_MAX_AGE;
      // 服务端那份指向另一卷，且用户还没动手：跟过去，并说明为什么
      if (fresh && last.caseId !== selected && !userPicked && !explicitCase) {
        selected = last.caseId;
        selectCase(last.caseId, 'replace', true, '', location.hash);
        showResume(last);
        return;
      }
      // 否则按当前这一卷记一笔；十分钟内重复进入不会重复写
      if (store.markReading(selected) && sync) sync.note();
      if (remote && fresh && last.caseId === selected) showResume(last);
    }

    async function startSync() {
      if (!PROGRESS_SYNC) {
        settleSpot();
        return;
      }
      // 运行时开关以服务端为准：静态站构建期拿不到线上配置，接口 404 / 关掉都退回纯本地
      let allowed = true;
      try {
        const meta = await api('GET', '/meta');
        allowed = meta?.features?.progressSync !== false;
      } catch {
        allowed = true;
      }
      if (!allowed) {
        settleSpot();
        return;
      }
      sync = createProgressSync(store, { request: api, owner: store.owner });
      sync.start();
      if (badge) {
        badge.hidden = false;
        mountBadge(badge, sync);
      }
      // 断网回来、从后台切回来都补一轮；不合批等待，直接推
      window.addEventListener('online', () => sync && sync.syncNow());
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') sync.syncNow();
      });
      await sync.syncNow(); // 首轮（拉 + 补推）跑完再决定落到哪一卷
      settleSpot(true);
    }
    startSync().catch(() => settleSpot());

    // 登录 / 登出 / 切号都重绑桶：上一版是全站一把钥匙，切号会看到别人的勾选。
    // 顺序有讲究：先让同步层把上一个账号的待推项归到它自己的队列，再换仓库的桶。
    onAuthChange((user) => {
      if (sync) sync.setOwner(user ? user.id : GUEST_OWNER);
      draftOwner = user ? user.id : GUEST_OWNER;
      store.setOwner(draftOwner);
      if (user) {
        store.adoptGuest(); // 未登录时勾的，进门就并进账号
        if (sync) sync.note(); // 并进来的那批也要推上去
      }
    });
    // 别的标签页或登录态改了才重画；自己刚点的由点击路径就地更新，避免焦点丢失。
    store.subscribe(({ reason }) => {
      // 勾选 / 清空 / 并入都意味着「本机有新意图」，交给同步层排队。
      // 'remote' 是服务端自己下发的，不能反手再推一次（会变成乒乓）。
      if (sync && reason !== 'remote') sync.note();
      if (reason === 'toggle') return;
      renderModules(byId.get(selected));
      renderTrainer(byId.get(selected));
      syncCardProgress();
    });

    const text = (id, value) => { const el = document.getElementById(id); if (el) el.textContent = value; };

    function syncCardProgress() {
      for (const item of cases) {
        const bar = document.querySelector(`[data-card-progress="${item.id}"]`);
        if (bar) bar.style.width = `${Math.min(100, store.count(item.id) / item.modules.length * 100)}%`;
      }
    }

    function renderModules(item) {
      const focus = captureFocus();
      moduleList.replaceChildren();
      item.modules.forEach((module, index) => {
        const row = document.createElement('div');
        row.className = 'juben-module';
        const label = document.createElement('label');
        label.className = 'juben-module-toggle';
        const input = document.createElement('input');
        input.type = 'checkbox';
        input.checked = store.isDone(item.id, module.slug);
        input.dataset.jubenFocus = `module:${item.id}:${module.slug}`;
        input.setAttribute('aria-label', `完成：${module.title}`);
        input.addEventListener('change', () => {
          store.toggle(item.id, module.slug);
          updateProgress(item);
          renderMissionMap(item);
          renderTrainer(item);
          syncCardProgress();
        });
        const check = document.createElement('span');
        check.className = 'juben-check';
        check.textContent = '✓';
        check.setAttribute('aria-hidden', 'true');
        const copy = document.createElement('span');
        copy.className = 'juben-module-copy';
        const strong = document.createElement('strong');
        strong.textContent = `${String(index + 1).padStart(2, '0')} · ${module.title}`;
        const small = document.createElement('small');
        small.textContent = module.desc;
        copy.append(strong, small);
        label.append(input, check, copy);
        const play = document.createElement('button');
        play.type = 'button';
        play.className = 'juben-module-play';
        play.dataset.jubenFocus = `play:${item.id}:${module.slug}`;
        play.textContent = input.checked ? '再练' : '训练 →';
        play.setAttribute('aria-label', `训练第 ${index + 1} 关：${module.title}`);
        play.addEventListener('click', () => selectMission(module.slug));
        row.append(label, play);
        moduleList.append(row);
      });
      updateProgress(item);
      renderMissionMap(item);
      restoreFocus(focus);
    }

    function renderMissionMap(item) {
      const focus = captureFocus();
      const map = document.getElementById('mission-map');
      map.replaceChildren();
      item.modules.forEach((module, index) => {
        const button = document.createElement('button');
        const done = store.isDone(item.id, module.slug);
        const active = module.slug === selectedMissionSlug;
        button.type = 'button';
        button.className = `juben-mission-node${done ? ' is-done' : ''}${active ? ' is-active' : ''}`;
        button.dataset.jubenFocus = `mission:${item.id}:${module.slug}`;
        button.setAttribute('aria-pressed', String(active));
        button.setAttribute('aria-label', `第 ${index + 1} 关：${module.title}${done ? '，已完成' : ''}`);
        const no = document.createElement('span');
        no.textContent = done ? '✓' : String(index + 1).padStart(2, '0');
        const title = document.createElement('strong');
        title.textContent = module.title;
        button.append(no, title);
        button.addEventListener('click', () => selectMission(module.slug));
        map.append(button);
      });
      restoreFocus(focus);
    }

    function updateProgress(item) {
      const done = store.count(item.id);
      const total = item.modules.length;
      const ranks = ['见习 DM', '流程侦察员', '线索织网者', '复盘预备役', '彩排就绪'];
      text('progress-label', `${done} / ${total}`);
      text('training-rank', ranks[Math.min(done, ranks.length - 1)]);
      const next = firstOpenMission(item, (caseId, slug) => store.isDone(caseId, slug));
      text('training-next', done === total
        ? '四关已点亮。现在做一次完整彩排，把卡壳处写回自己的主持笔记。'
        : `下一关：${next.module.title} · ${next.module.deliverable}`);
      const start = document.getElementById('start-training');
      start.innerHTML = `${done === total ? '重新巡演' : done ? `继续第 ${next.index + 1} 关` : '开始第 1 关'} <span aria-hidden="true">→</span>`;
      const track = document.getElementById('progress-track');
      track.setAttribute('aria-valuemax', String(total));
      track.setAttribute('aria-valuenow', String(done));
      document.getElementById('progress-bar').style.width = `${done / total * 100}%`;
    }

    function renderTrainer(item, message = '') {
      if (!item) return;
      const focus = captureFocus();
      const current = missionAt(item, selectedMissionSlug);
      selectedMissionSlug = current.module.slug;
      const { module, index } = current;
      const done = store.isDone(item.id, module.slug);
      const following = nextMission(item, module.slug);
      text('trainer-step', `Mission ${String(index + 1).padStart(2, '0')} / ${String(item.modules.length).padStart(2, '0')}`);
      text('trainer-title', module.title);
      text('trainer-challenge', module.challenge);
      text('trainer-deliverable', module.deliverable);
      text('trainer-state', done ? '已过关' : '进行中');
      document.getElementById('trainer-state').dataset.done = String(done);
      const draft = document.getElementById('trainer-draft');
      const currentDraftKey = draftKey(item.id, module.slug);
      if (draft.dataset.key !== currentDraftKey) {
        draft.value = loadDraft(item.id, module.slug);
        draft.dataset.key = currentDraftKey;
      }
      updateDraftWarning(item.id, module.slug);
      const checks = document.getElementById('trainer-checks');
      checks.replaceChildren();
      const legend = document.createElement('legend');
      legend.textContent = '完成后，用三条自检确认不是“看懂了”而是“能主持”';
      checks.append(legend);
      const checkKey = `${item.id}/${module.slug}`;
      const savedChecks = selfCheckState.get(checkKey) || [];
      module.checks.forEach((labelText, checkIndex) => {
        const label = document.createElement('label');
        const input = document.createElement('input');
        input.type = 'checkbox';
        input.checked = Boolean(savedChecks[checkIndex]);
        input.dataset.jubenFocus = `check:${item.id}:${module.slug}:${checkIndex}`;
        input.addEventListener('change', () => {
          const values = selfCheckState.get(checkKey) || module.checks.map(() => false);
          values[checkIndex] = input.checked;
          selfCheckState.set(checkKey, values);
          updateTrainerAction();
        });
        const span = document.createElement('span');
        span.textContent = labelText;
        label.append(input, span);
        checks.append(label);
      });
      const complete = document.getElementById('trainer-complete');
      complete.hidden = done;
      complete.disabled = true;
      const next = document.getElementById('trainer-next');
      next.hidden = !done || !following;
      next.innerHTML = following ? `下一关：${following.module.title} <span aria-hidden="true">→</span>` : '';
      document.getElementById('trainer-doc').href = missionHref(url('juben/'), item.id, module.slug);
      text('trainer-status', message || (done && !following ? '四关全部点亮。去完整彩排一次，别再逐字念手册。' : done ? '本关已完成，可以进入下一关，也可以留下再练一次。' : '先试着复述，再打开档案校对；三条自检都确认后即可过关。'));
      renderMissionMap(item);
      updateTrainerAction();
      restoreFocus(focus);
    }

    function updateTrainerAction() {
      const inputs = [...document.querySelectorAll('#trainer-checks input[type="checkbox"]')];
      const remaining = inputs.filter((input) => !input.checked).length;
      const complete = document.getElementById('trainer-complete');
      complete.disabled = remaining > 0;
      if (!complete.hidden) {
        text('trainer-status', remaining ? `还差 ${remaining} 条自检。草稿不必漂亮，能脱稿主持才是通关条件。` : '自检完成。确认过关，点亮这一枚任务节点。');
      }
    }

    function updateHistory(caseId, moduleSlug, mode, hash = '') {
      if (!mode) return;
      const target = new URL(location.href);
      target.searchParams.set('case', caseId);
      target.searchParams.set('module', moduleSlug);
      target.searchParams.delete('view');
      if (hash !== null) target.hash = hash;
      if (target.href === location.href) return;
      history[mode === 'replace' ? 'replaceState' : 'pushState']({ juben: true }, '', target);
    }

    function selectMission(slug, historyMode = 'push', hash = '', scroll = true) {
      userPicked = true;
      const item = byId.get(selected);
      const current = missionAt(item, slug);
      selectedMissionSlug = current.module.slug;
      renderTrainer(item);
      updateHistory(selected, selectedMissionSlug, historyMode, hash);
      window.dispatchEvent(new CustomEvent('atw-juben-mission', { detail: { caseId: selected, moduleSlug: selectedMissionSlug } }));
      if (scroll) {
        document.getElementById('juben-practice').open = true;
        document.getElementById('juben-trainer').scrollIntoView({ behavior: scrollBehavior(), block: 'center' });
      }
    }

    function openMissionDoc(slug) {
      selectMission(slug, 'push', 'dm-vault', false);
      document.getElementById('dm-vault').scrollIntoView({ behavior: scrollBehavior(), block: 'start' });
    }

    // 自测题停在第几题：按卷记在本机。它只是「我这台设备上次想的是哪题」，
    // 不上传——手机上做过的那道题不该把电脑上的位置改掉。
    const QUIZ_KEY = 'atw-juben-quiz';
    function loadQuizMap() {
      try {
        const raw = localStorage.getItem(QUIZ_KEY);
        const parsed = raw ? JSON.parse(raw) : {};
        return parsed && typeof parsed === 'object' ? parsed : {};
      } catch {
        return {};
      }
    }
    function loadQuizIndex(caseId) {
      const total = byId.get(caseId)?.questions?.length || 0;
      if (!total) return 0;
      const saved = Number(loadQuizMap()[caseId]);
      return Number.isInteger(saved) && saved >= 0 && saved < total ? saved : 0;
    }
    function saveQuizIndex(caseId, index) {
      try {
        const map = loadQuizMap();
        map[caseId] = index;
        localStorage.setItem(QUIZ_KEY, JSON.stringify(map));
      } catch {
        /* 隐私模式下存不住：本次会话内照常翻题 */
      }
    }

    function selectCase(id, historyMode = 'push', mark = true, requestedModule = '', hash = '') {
      const item = byId.get(id);
      if (!item) return;
      selected = id;
      quizIndex = loadQuizIndex(id);
      detail.dataset.tone = item.tone;
      text('detail-code', item.english);
      text('detail-title', item.title);
      text('detail-intro', item.intro);
      text('detail-status', item.status);
      text('fact-players', item.players);
      text('fact-duration', item.duration);
      text('fact-genre', item.genre);
      text('fact-level', item.level);
      text('quiz-question', item.questions[quizIndex] || item.questions[0]);
      // 手动切卷之后「上次读到」这行就该收起来，不然它一直挂着像在提示别的卷
      const resume = document.getElementById('juben-resume');
      if (resume) resume.hidden = true;
      // 记下「正读这一卷」：写进同一份进度里，换设备也能接着这一卷打开。
      // markReading 不广播事件，所以这里显式让同步层收一次。
      if (mark && store.markReading(id) && sync) sync.note();
      const firstMission = firstOpenMission(item, (caseId, slug) => store.isDone(caseId, slug));
      selectedMissionSlug = missionAt(item, requestedModule || firstMission.module.slug).module.slug;
      document.getElementById('private-link').href = missionHref(url('juben/'), id, item.modules[0].slug);
      document.getElementById('timeline-link').href = missionHref(url('juben/'), id, item.modules[1].slug);
      document.querySelectorAll('#run-link, #review-link, #board-link').forEach((link) => { link.hidden = id !== 'virtual-game'; });
      cards.forEach((card) => {
        const active = card.dataset.case === id;
        card.classList.toggle('is-active', active);
        card.setAttribute('aria-pressed', String(active));
      });
      renderModules(item);
      renderTrainer(item);
      updateHistory(id, selectedMissionSlug, historyMode, hash);
      window.dispatchEvent(new CustomEvent('atw-juben-mission', { detail: { caseId: id, moduleSlug: selectedMissionSlug } }));
    }

    function applyCaseFilter() {
      const query = (search.value || '').trim().toLocaleLowerCase('zh-CN');
      let shown = 0;
      for (const card of cards) {
        const matchesStatus = activeFilter === 'all' || card.dataset.status === activeFilter;
        const matchesQuery = !query || (card.dataset.search || '').toLocaleLowerCase('zh-CN').includes(query);
        const visible = matchesStatus && matchesQuery;
        card.hidden = !visible;
        if (visible) shown += 1;
      }
      empty.hidden = shown > 0;
      result.textContent = `${shown} / ${cases.length} 卷档案`;
    }

    cards.forEach((card) => card.addEventListener('click', () => {
      userPicked = true; // 用户自己挑了卷：别再自动跳回「上次」
      selectCase(card.dataset.case);
    }));
    filterButtons.forEach((button) => button.addEventListener('click', () => {
      activeFilter = button.dataset.filter;
      filterButtons.forEach((item) => {
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      applyCaseFilter();
    }));
    search.addEventListener('input', applyCaseFilter);

    groupButtons.forEach((button) => button.addEventListener('click', () => {
      const group = button.dataset.group;
      groupButtons.forEach((item) => {
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      document.querySelectorAll('.juben-table-wrap tbody tr').forEach((row) => {
        row.hidden = group !== 'all' && row.dataset.group !== group;
      });
    }));

    document.getElementById('next-question').addEventListener('click', () => {
      const item = byId.get(selected);
      quizIndex = (quizIndex + 1) % item.questions.length;
      text('quiz-question', item.questions[quizIndex]);
      saveQuizIndex(selected, quizIndex);
    });

    document.getElementById('start-training').addEventListener('click', () => {
      const item = byId.get(selected);
      const next = firstOpenMission(item, (caseId, slug) => store.isDone(caseId, slug));
      selectMission(next.module.slug);
    });
    document.getElementById('trainer-doc').addEventListener('click', (event) => {
      event.preventDefault();
      openMissionDoc(selectedMissionSlug);
    });
    document.getElementById('private-link').addEventListener('click', (event) => {
      event.preventDefault();
      openMissionDoc(byId.get(selected).modules[0].slug);
    });
    document.getElementById('timeline-link').addEventListener('click', (event) => {
      event.preventDefault();
      openMissionDoc(byId.get(selected).modules[1].slug);
    });
    document.getElementById('trainer-draft').addEventListener('input', (event) => {
      saveDraft(selected, selectedMissionSlug, event.target.value);
      updateDraftWarning(selected, selectedMissionSlug);
    });
    document.getElementById('trainer-complete').addEventListener('click', () => {
      const item = byId.get(selected);
      if (!store.isDone(selected, selectedMissionSlug)) store.toggle(selected, selectedMissionSlug);
      updateProgress(item);
      syncCardProgress();
      renderTrainer(item, '过关！任务节点已点亮，进度仍按原有规则同步。');
      const following = nextMission(item, selectedMissionSlug);
      const focusTarget = following ? document.getElementById('trainer-next') : document.getElementById('trainer-status');
      focusTarget?.focus({ preventScroll: true });
    });
    document.getElementById('trainer-next').addEventListener('click', () => {
      const next = nextMission(byId.get(selected), selectedMissionSlug);
      if (next) {
        selectMission(next.module.slug);
        document.querySelector('.juben-mission-node.is-active')?.focus({ preventScroll: true });
      }
    });
    window.addEventListener('atw-juben-request-mission', (event) => {
      const { caseId, moduleSlug, hash = 'dm-vault' } = event.detail || {};
      if (byId.has(caseId)) {
        userPicked = true;
        selectCase(caseId, 'push', true, moduleSlug, hash);
      }
    });
    window.addEventListener('popstate', () => {
      const params = new URLSearchParams(location.search);
      const requestedCase = params.get('case');
      const caseId = byId.has(requestedCase) ? requestedCase : cases[0]?.id;
      if (!caseId) return;
      userPicked = true;
      spotSettled = true;
      selectCase(caseId, false, true, params.get('module') || '');
      const target = location.hash === '#dm-vault'
        ? document.getElementById('dm-vault')
        : document.getElementById('juben-trainer');
      if (location.hash !== '#dm-vault') document.getElementById('juben-practice').open = true;
      target?.scrollIntoView({ behavior: 'auto', block: location.hash === '#dm-vault' ? 'start' : 'center' });
    });

    document.getElementById('reset-progress').addEventListener('click', () => {
      store.resetCase(selected);
      renderModules(byId.get(selected));
      renderTrainer(byId.get(selected));
      syncCardProgress();
    });

    document.getElementById('copy-path').addEventListener('click', async (event) => {
      const item = byId.get(selected);
      const checklist = [
        `《${item.title}》学习清单`,
        ...item.modules.map((module, index) => `${store.isDone(item.id, module.slug) ? '[x]' : '[ ]'} ${index + 1}. ${module.title}：${module.desc}`),
        '', '公开学习导航：蛛网之上 · 剧本研究室',
      ].join('\n');
      const button = event.currentTarget;
      try {
        await navigator.clipboard.writeText(checklist);
        button.textContent = '已复制';
      } catch (_) {
        const area = document.createElement('textarea');
        area.value = checklist;
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.append(area);
        area.select();
        const ok = document.execCommand('copy');
        area.remove();
        button.textContent = ok ? '已复制' : '复制失败，请重试';
      }
      setTimeout(() => { button.textContent = '复制学习清单'; }, 1800);
    });

    // 首屏先画出来（本地优先），位置留到首轮同步回来再由 settleSpot 定
    if (askedModule && location.hash !== '#dm-vault') document.getElementById('juben-practice').open = true;
    selectCase(selected, false, false, askedModule);
    syncCardProgress();
    if (resumedFrom) showResume(resumedFrom);
  })();
</script>
