---
// 剧本研究室 · /juben/ —— 公开学习导航与跨本结构归纳。
// 任何凶手、完整真相、诡计解答、结局与原始剧本都不得写入 src/data/juben.js。
import BaseLayout from '../../layouts/BaseLayout.astro';
import { jubenCases, comparisonRows, methodSteps } from '../../data/juben.js';
import { KB_REPO, KB_BRANCH } from '../../lib/site.mjs';

const first = jubenCases[0];
const workspaceCase = jubenCases.find((item) => item.id === 'virtual-game');
const deconstructSkillUrl = `${KB_REPO}/tree/${KB_BRANCH}/07_skill存档/juben-deconstruct`;
---

<BaseLayout
  title="剧本研究室"
  description="剧本杀 DM 的交互式学习档案：流程骨架、上帝视角、线索组织、复述自测与跨本结构对比。公开页面无答案剧透。"
  section="juben"
>
  <div class="juben-page">
    <header class="juben-hero">
      <div class="juben-hero-copy">
        <h1>剧本研究室</h1>
        <p class="juben-hero-desc">选一卷，从开本流程学起，或直接进入案件复盘和白板演练。</p>
      </div>
    </header>

    <div class="juben-notice" role="note">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 3 3.5 7.5v5c0 4.7 3.5 7.7 8.5 9 5-1.3 8.5-4.3 8.5-9v-5L12 3Z"/><path d="M12 8v4M12 16h.01"/></svg>
      <p>案件答案与原始资料仅对持邀请码的 DM 开放。</p>
    </div>

    <section class="juben-library" aria-labelledby="library-title">
      <header class="juben-section-head">
        <div>
          <h2 id="library-title">选择剧本</h2>
        </div>
      </header>

      <details class="juben-filter-panel">
        <summary>搜索与筛选</summary>
        <div class="juben-tools">
        <label class="juben-search">
          <span class="sr-only">搜索剧本或标签</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.2 4.2"/></svg>
          <input id="juben-search" type="search" placeholder="搜索剧名、标签或主持重点" autocomplete="off" />
        </label>
        <div class="juben-filters" aria-label="按学习状态筛选">
          <button class="is-active" type="button" data-filter="all" aria-pressed="true">全部 <span>{jubenCases.length}</span></button>
          <button type="button" data-filter="learning" aria-pressed="false">学习中</button>
          <button type="button" data-filter="ready" aria-pressed="false">资料就绪</button>
        </div>
        </div>
      </details>

      <div class="juben-workbench">
        <div class="juben-case-column">
          <p class="juben-result" id="juben-result" aria-live="polite">{jubenCases.length} 卷档案</p>
          <div class="juben-case-list" id="juben-case-list">
            {jubenCases.map((item, index) => (
              <button
                class:list={['juben-case-card', { 'is-active': index === 0 }]}
                type="button"
                data-case={item.id}
                data-status={item.statusKey}
                data-search={`${item.title} ${item.english} ${item.genre} ${item.level} ${item.tags.join(' ')} ${item.compare.dm}`}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                <span class={`juben-status ${item.statusKey}`}>{item.status}</span>
                <strong>{item.title}</strong>
                <small>{item.english}</small>
                <span class="juben-case-desc">{item.intro}</span>
                <span class="juben-case-meta">{item.players}<i></i>{item.duration}<i></i>{item.level}</span>
                <span class="juben-card-progress"><b data-card-progress={item.id} style="width:0%"></b></span>
              </button>
            ))}
          </div>
          <p class="juben-empty" id="juben-empty" hidden>没有找到对应档案，换个关键词试试。</p>
        </div>

        <article class="juben-detail" id="juben-detail" data-tone={first.tone} aria-live="polite">
          <header class="juben-detail-head">
            <div>
              <p class="juben-detail-code" id="detail-code">{first.english}</p>
              <h3 id="detail-title">{first.title}</h3>
              <p id="detail-intro">{first.intro}</p>
            </div>
            <span class="juben-detail-status" id="detail-status">{first.status}</span>
          </header>

          <p class="juben-resume" id="juben-resume" hidden></p>

          <dl class="juben-facts" id="detail-facts">
            <div><dt>配置</dt><dd id="fact-players">{first.players}</dd></div>
            <div><dt>时长</dt><dd id="fact-duration">{first.duration}</dd></div>
            <div><dt>类型</dt><dd id="fact-genre">{first.genre}</dd></div>
            <div><dt>建议</dt><dd id="fact-level">{first.level}</dd></div>
          </dl>

          <nav class="juben-study-links" aria-label="本卷学习入口">
            {workspaceCase && <a class="juben-study-primary" id="run-link" href={`?case=${workspaceCase.id}&view=run#dm-vault`}>现场带本 <span>按步骤主持与计时 →</span></a>}
            <a class="juben-study-primary" id="private-link" href={`?case=${first.id}&module=${first.modules[0].slug}#dm-vault`}>开始学本 <span>打开 DM 学习手册 →</span></a>
            {workspaceCase && <a id="review-link" href={`?case=${workspaceCase.id}&view=review#dm-vault`}>案件复盘 <span>查看图解与提示 →</span></a>}
            {workspaceCase && <a id="board-link" href={`?case=${workspaceCase.id}&view=board#dm-vault`}>白板演练 <span>逐笔跟画 →</span></a>}
            <a id="timeline-link" href={`?case=${first.id}&module=${first.modules[1].slug}#dm-vault`}>故事与时间线 <span>核对完整经过 →</span></a>
          </nav>

          <details class="juben-practice" id="juben-practice">
          <summary>主持训练与自测</summary>
          <section class="juben-learning" aria-labelledby="learning-title">
            <div class="juben-learning-head">
              <div>
                <p class="juben-kicker">DM Training Run</p>
                <h4 id="learning-title">四关主持训练</h4>
              </div>
              <div class="juben-learning-status">
                <span id="progress-label">0 / {first.modules.length}</span>
                <button type="button" class="juben-sync" id="sync-badge" data-state="guest" hidden>本机记录</button>
              </div>
            </div>
            <div class="juben-progress-track" id="progress-track" role="progressbar" aria-label="当前剧本学习进度" aria-valuemin="0" aria-valuemax={first.modules.length} aria-valuenow="0">
              <b id="progress-bar"></b>
            </div>
            <div class="juben-training-callout">
              <div><strong id="training-rank">见习 DM</strong><p id="training-next">每次只练一件事，完成四关就能做一次完整彩排。</p></div>
              <button type="button" id="start-training">开始第 1 关 <span aria-hidden="true">→</span></button>
            </div>
            <div class="juben-mission-map" id="mission-map" aria-label="训练关卡"></div>
            <div class="juben-module-list" id="module-list">
              {first.modules.map((module, index) => (
                <span>{index + 1}. {module.title}</span>
              ))}
            </div>
            <section class="juben-trainer" id="juben-trainer" aria-labelledby="trainer-title">
              <header>
                <div><p class="juben-kicker" id="trainer-step">Mission 01 / 04</p><h5 id="trainer-title">{first.modules[0].title}</h5></div>
                <span id="trainer-state">进行中</span>
              </header>
              <p class="juben-trainer-challenge" id="trainer-challenge">{first.modules[0].challenge}</p>
              <p class="juben-trainer-deliverable"><span>本关产出</span><strong id="trainer-deliverable">{first.modules[0].deliverable}</strong></p>
              <label class="juben-trainer-draft">
                <span>脱稿草稿 <small>只保存在本机，可留空，直接口头复述也算</small></span>
                <textarea id="trainer-draft" rows="4" maxlength="4000" placeholder="合上资料，用自己的话写几句；卡住的地方正是下一遍要看的。"></textarea>
              </label>
              <p class="juben-trainer-draft-warning" id="trainer-draft-warning" role="alert" hidden>本机存储失败：这段草稿尚未保存，只保留在当前页面内存中。请复制备份；刷新或离开后会丢失。</p>
              <fieldset class="juben-trainer-checks" id="trainer-checks">
                <legend>完成后，用三条自检确认不是“看懂了”而是“能主持”</legend>
              </fieldset>
              <p class="juben-trainer-status" id="trainer-status" role="status" tabindex="-1"></p>
              <div class="juben-trainer-actions">
                <a id="trainer-doc" href={`?case=${first.id}&module=${first.modules[0].slug}#dm-vault`}>打开本关档案 <span aria-hidden="true">→</span></a>
                <button type="button" id="trainer-complete">完成本关</button>
                <button type="button" id="trainer-next" hidden>进入下一关 <span aria-hidden="true">→</span></button>
              </div>
            </section>
            <div class="juben-learning-actions">
              <button type="button" id="copy-path">复制学习清单</button>
              <button type="button" id="reset-progress">清空本卷进度</button>
            </div>
          </section>

          <section class="juben-quiz" aria-labelledby="quiz-title">
            <div class="juben-quiz-mark" aria-hidden="true">?</div>
            <div>
              <p class="juben-kicker">Recall Practice</p>
              <h4 id="quiz-title">脱稿复述一题</h4>
              <p id="quiz-question">{first.questions[0]}</p>
              <button type="button" id="next-question">换一道 <span aria-hidden="true">→</span></button>
            </div>
          </section>

          </details>
        </article>
      </div>
    </section>

    <section class="juben-vault" id="dm-vault" aria-labelledby="vault-title">
      <header class="juben-section-head">
        <div>
          <h2 id="vault-title">DM 档案库</h2>
        </div>
        <p id="vault-state">按登录身份开放：整卷拆解、时间线与带本提醒。</p>
      </header>
      <p class="juben-vault-note">
        登录后可在此兑换 DM 邀请码。
      </p>
      <div class="juben-vault-body" id="vault-body" aria-live="polite">
        <p class="juben-vault-loading">正在确认身份…</p>
      </div>
    </section>

    <details class="juben-reference">
      <summary>跨本对照与拆解方法</summary>
    <section class="juben-compare" aria-labelledby="compare-title">
      <header class="juben-section-head">
        <div>
          <h2 id="compare-title">跨本对照</h2>
        </div>
        <p>比较设计结构，不比较谜底。点击维度收起无关行。</p>
      </header>
      <div class="juben-compare-filters" aria-label="对比维度">
        <button class="is-active" type="button" data-group="all" aria-pressed="true">全部维度</button>
        <button type="button" data-group="structure" aria-pressed="false">流程与机制</button>
        <button type="button" data-group="clues" aria-pressed="false">线索与真相</button>
        <button type="button" data-group="hosting" aria-pressed="false">主持执行</button>
      </div>
      <div class="juben-table-wrap">
        <table>
          <thead>
            <tr><th scope="col">维度</th>{jubenCases.map((item) => <th scope="col">{item.title}</th>)}</tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr data-group={row.group}>
                <th scope="row">{row.label}{row.hint && <small>{row.hint}</small>}</th>
                {jubenCases.map((item) => <td>{item.compare[row.key]}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="juben-compare-insight"><span>对照结论</span>同为六人硬核还原，两本需要训练的 DM 能力并不相同：一本更吃节奏与复盘表达，一本更吃物料与流程执行。学习路径也应因此不同。</p>
    </section>

    <section class="juben-method" aria-labelledby="method-title">
      <header class="juben-section-head">
        <div>
          <h2 id="method-title">下一本，怎么拆</h2>
        </div>
        <p>一条可以反复使用的五步学习线。</p>
      </header>
      <div class="juben-method-grid">
        <div class="juben-method-intro">
          <p>从“读完一份剧本”到“能独立带完全场”，中间隔着五次主动加工。</p>
          <a href={deconstructSkillUrl} target="_blank" rel="noopener">查看拆解 Skill <span>↗</span></a>
        </div>
        <div class="juben-accordion">
          {methodSteps.map((step) => (
            <details>
              <summary><span>{step.no}</span><strong>{step.title}</strong><i aria-hidden="true"></i></summary>
              <div><p>{step.desc}</p><small>{step.output}</small></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    </details>
  </div>

  <script type="application/json" id="juben-data" set:html={JSON.stringify(jubenCases)}></script>
</BaseLayout>

<script>
  // DM 档案库：整卷拆解只对 dm/admin 开放，member 在这里兑换邀请码。
  // 与公开训练区共用 case/module 深链；正文不进入公开数据，身份变化立即清掉。
  import { api, ApiError, cacheUser, displayNameOf, escapeHtml, getCachedUser, getToken, loginUrl, registerUrl, refreshUser, isDm, onAuthChange } from '../../scripts/account-core.js';
  import { renderMarkdown } from '../../scripts/mini-markdown.js';
  import { mountWhiteboardCards } from '../../scripts/whiteboard-cards.js';
  import { linkReviewBoard } from '../../scripts/juben-review-board.js';
  import { attachRunbookReferences, mountRunbook } from '../../scripts/juben-runbook.js';
  import { jubenCases } from '../../data/juben.js';
  import { nextMission, resolveVaultMission, vaultDocList } from '../../scripts/juben-journey.js';

  const body = document.getElementById('vault-body');
  const state = document.getElementById('vault-state');
  if (body && state) {
    let user = getCachedUser();
    let sessionToken = getToken();
    let manifest = null;
    let activeCase = null;
    let activeDoc = null;
    let directPrivateCase = null;
    let inviteInfo = null;
    let docRequest = 0;
    let docController;
    const recentDocs = new Map();
    let vaultGeneration = 0;
    const query = new URLSearchParams(location.search);
    let pendingMission = {
      caseId: query.get('case') || jubenCases[0]?.id,
      moduleSlug: query.get('module') || jubenCases[0]?.modules[0]?.slug,
    };

    const setState = (text) => { state.textContent = text; };
    const identityKey = (value) => value ? `${value.id}:${isDm(value) ? 'dm' : 'member'}` : 'guest';
    const scrollBehavior = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    const beginVaultRender = () => {
      docController?.abort();
      vaultGeneration += 1;
      docRequest += 1;
      return vaultGeneration;
    };
    const isCurrentVault = (generation, identity = identityKey(user)) => (
      generation === vaultGeneration && identity === identityKey(user) && sessionToken === getToken()
    );

    function updateGateLinks() {
      // 保留 hash：从某一关去登录，回来仍落在档案库而不是页面顶部。
      const here = location.pathname + location.search + location.hash;
      const login = document.querySelector('[data-vault-login]');
      const register = document.querySelector('[data-vault-register]');
      if (login) login.href = loginUrl(here);
      if (register) register.href = registerUrl(here);
    }

    function renderAnonymous() {
      setState('未登录 · 公开区随便看，档案库要身份');
      body.innerHTML = `
        <div class="juben-vault-gate">
          <p>读公开区不用账号；进档案库需要站内账号 + DM 邀请码。当前关卡会保留，登录后接着走。</p>
          <p class="juben-vault-gate-actions">
            <a class="juben-vault-cta" data-vault-login href="${loginUrl(location.pathname + location.search + location.hash)}">登录并继续</a>
            <a class="juben-vault-cta is-ghost" data-vault-register href="${registerUrl(location.pathname + location.search + location.hash)}">注册</a>
          </p>
        </div>`;
    }

    function renderRedeem() {
      const retry = new URLSearchParams(location.search).get('dm') === 'retry';
      setState(retry ? '已登录 · 邀请码没通过' : '已登录 · 还差一枚邀请码');
      body.innerHTML = `
        <form class="juben-vault-redeem" id="vault-redeem">
          ${retry ? '<p class="juben-vault-msg" data-tone="error">账号已经建好了，但那枚码没通过。再试一次，或者问发码的人。</p>' : ''}
          <label><span>邀请码</span><input name="code" autocomplete="off" spellcheck="false" placeholder="XXXXX-XXXXX" required /></label>
          <button type="submit">兑换 DM 身份</button>
          <p class="juben-vault-msg" id="vault-redeem-msg" role="status"></p>
        </form>`;
      document.getElementById('vault-redeem').addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.target;
        const msg = document.getElementById('vault-redeem-msg');
        const generation = vaultGeneration;
        const identity = identityKey(user);
        form.querySelector('button').disabled = true;
        msg.textContent = '兑换中…';
        msg.dataset.tone = 'busy';
        try {
          const result = await api('POST', '/dm/redeem', { code: form.code.value.trim() });
          if (!isCurrentVault(generation, identity)) return;
          user = result.user;
          inviteInfo = result.invite;
          cacheUser(result.user);
          renderForUser();
        } catch (error) {
          if (!isCurrentVault(generation, identity)) return;
          form.querySelector('button').disabled = false;
          msg.textContent = error.message;
          msg.dataset.tone = 'error';
        }
      });
    }

    async function loadManifest() {
      return manifest || api('GET', '/juben/manifest');
    }

    function missionTarget() {
      return resolveVaultMission(jubenCases, manifest?.cases || [], pendingMission.caseId, pendingMission.moduleSlug);
    }

    function applyMissionTarget() {
      if (directPrivateCase) {
        const entry = manifest?.cases?.find((item) => item.id === directPrivateCase);
        if (entry) {
          activeCase = entry.id;
          activeDoc = vaultDocList(entry)[0]?.id || null;
          return null;
        }
        directPrivateCase = null;
      }
      const target = missionTarget();
      if (!target) return null;
      activeCase = target.vaultCaseId;
      activeDoc = target.manifestCase ? target.docId : null;
      const view = requestedWorkspace();
      const workspaceCase = jubenCases.find((item) => item.id === 'virtual-game');
      if (view && activeCase === workspaceCase?.vaultCaseId) {
        const docId = view === 'board' ? '09_人物关系白板示意图' : workspaceCase.modules[0].docId;
        if (target.manifestCase && vaultDocList(target.manifestCase).some((doc) => doc.id === docId)) {
          activeDoc = docId;
          return null;
        }
      }
      return target;
    }

    function requestedWorkspace() {
      const view = new URLSearchParams(location.search).get('view');
      return ['review', 'board', 'run'].includes(view) ? view : '';
    }

    const vaultDocPath = (caseId, docId) => `/juben/doc/${encodeURIComponent(caseId)}/${encodeURIComponent(docId)}`;

    async function loadVaultDoc(caseId, docId, current, signal) {
      const path = vaultDocPath(caseId, docId);
      const cached = recentDocs.get(path);
      if (cached && Date.now() < cached.expires) {
        recentDocs.delete(path);
        recentDocs.set(path, cached);
        return cached.doc;
      }
      for (let attempt = 0; current(); attempt += 1) {
        try {
          const payload = await api('GET', `${path}?audio=deferred`, undefined, { cache: 'no-store', requireJson: true, signal });
          if (payload?.configured === false) {
            throw new ApiError(0, 'JUBEN_UNCONFIGURED', '档案正文服务暂不可用');
          }
          if (payload?.doc?.id !== docId || typeof payload.doc.markdown !== 'string') {
            throw new ApiError(0, 'JUBEN_INCOMPLETE', '档案正文响应不完整');
          }
          if (!current()) return null;
          recentDocs.delete(path);
          recentDocs.set(path, { doc: payload.doc, expires: Date.now() + 5 * 60_000 });
          if (recentDocs.size > 8) recentDocs.delete(recentDocs.keys().next().value);
          return payload.doc;
        } catch (error) {
          const retryable = ['NETWORK', 'INVALID_JSON', 'JUBEN_INCOMPLETE'].includes(error.code)
            || [502, 503, 504].includes(error.status);
          if (attempt || !retryable) throw error;
        }
      }
      return null;
    }

    async function openDoc(caseId, docId) {
      if (!caseId || !docId || !isDm(user)) return;
      activeCase = caseId;
      activeDoc = docId;
      docController?.abort();
      docController = new AbortController();
      const { signal } = docController;
      const requestId = ++docRequest;
      const generation = vaultGeneration;
      const identity = identityKey(user);
      const host = document.getElementById('vault-reader-doc');
      if (!host) return;
      host.innerHTML = '<p class="juben-vault-loading">取文中…</p>';
      document.querySelectorAll('.juben-vault-doc').forEach((node) => {
        const active = node.dataset.doc === docId;
        node.classList.toggle('is-active', active);
        node.setAttribute('aria-pressed', String(active));
      });
      const current = () => (
        requestId === docRequest
        && isCurrentVault(generation, identity)
        && isDm(user)
        && document.getElementById('vault-reader-doc') === host
      );
      const reviewId = '00_DM主持学习手册';
      const boardId = '09_人物关系白板示意图';
      const view = requestedWorkspace();
      const companionId = caseId === '954-虚拟游戏'
        ? ({ [reviewId]: boardId, [boardId]: reviewId })[docId]
        : null;
      let workspaces;
      try {
        const doc = await loadVaultDoc(caseId, docId, current, signal);
        if (!current()) return;
        host.innerHTML = renderMarkdown(doc.markdown, { whiteboardImages: true });
        mountRunbook(host, view === 'run' && docId === reviewId, (key) => api('GET',
          `${vaultDocPath(caseId, docId)}/audio/${key}`, undefined, { cache: 'no-store', responseType: 'blob', signal }));
        workspaces = mountWhiteboardCards(host, { openTrace: true, openCases: view === 'review' });
        attachRunbookReferences(host, workspaces);
      } catch (error) {
        if (!current()) return;
        const message = error instanceof ApiError ? error.message : '档案正文暂时无法显示';
        host.innerHTML = `<p class="juben-vault-msg" data-tone="error">${escapeHtml(message)}</p>
          <button class="juben-vault-cta is-ghost juben-vault-retry" type="button">重新加载正文</button>`;
        host.querySelector('button').addEventListener('click', () => openDoc(caseId, docId), { once: true });
        return;
      }
      if (!companionId) return;
      // 先让当前正文可见，再请求关联图。
      await new Promise((resolve) => requestAnimationFrame(() => setTimeout(resolve, 0)));
      if (!current()) return;
      const linked = await loadVaultDoc(caseId, companionId, current, signal).catch(() => null);
      if (current() && linked) {
        const container = document.createElement('div');
        try {
          const template = document.createElement('template');
          template.innerHTML = renderMarkdown(linked.markdown, { whiteboardImages: true });
          const entry = template.content.querySelector('.md-trace-entry');
          if (entry) {
            container.className = 'md-companion-workspace';
            container.append(entry);
            host.append(container);
            const added = mountWhiteboardCards(container);
            attachRunbookReferences(host, added, { includeLive: false });
            linkReviewBoard([...workspaces, ...added]);
          }
        } catch {
          container.remove();
        }
      }
    }

    function renderDocList() {
      const caseData = manifest.cases.find((entry) => entry.id === activeCase);
      if (!caseData) return '<p class="juben-vault-msg" data-tone="error">当前公开卷尚未发布到 DM 档案库。请从左侧选择已发布卷宗。</p>';
      const flat = vaultDocList(caseData);
      if (flat.length && !flat.some((doc) => doc.id === activeDoc)) activeDoc = flat[0].id;
      const groups = caseData.groups?.length ? caseData.groups : [{ label: '档案', docs: flat }];
      if (!flat.length) return '<nav class="juben-vault-docs" aria-label="本卷目录"><p class="juben-vault-invite-sub">这一卷还没有文档。</p></nav>';
      return `
        <details class="juben-vault-directory">
          <summary>全部档案 <span>${flat.length} 篇 · 点击展开 / 收起</span></summary>
          <nav class="juben-vault-docs" aria-label="本卷目录">
            ${groups.map((group) => `
              <div class="juben-vault-group">
                <p class="juben-vault-group-title">${escapeHtml(group.label)}<span>${group.docs.length}</span></p>
                <div class="juben-vault-group-pills">
                  ${group.docs.map((doc) => `
                    <button type="button" class="juben-vault-doc${doc.id === activeDoc ? ' is-active' : ''}" data-doc="${escapeHtml(doc.id)}" title="${escapeHtml(doc.title)}" aria-pressed="${doc.id === activeDoc}">
                      ${escapeHtml(doc.title)}
                    </button>`).join('')}
                </div>
              </div>`).join('')}
          </nav>
        </details>`;
    }

    function renderMissionBar() {
      if (directPrivateCase) return '';
      const target = missionTarget();
      if (!target?.mission || !target.manifestCase) return '';
      const { module, index } = target.mission;
      const previous = index > 0 ? target.publicCase.modules[index - 1] : null;
      const following = nextMission(target.publicCase, module.slug);
      return `
        <section class="juben-vault-mission" aria-label="当前训练关卡">
          <div class="juben-vault-mission-copy">
            <p>当前关卡 · ${String(index + 1).padStart(2, '0')} / ${String(target.publicCase.modules.length).padStart(2, '0')}</p>
            <h3>${escapeHtml(module.title)}</h3>
            <span>${escapeHtml(module.challenge)}</span>
          </div>
          <div class="juben-vault-mission-actions">
            ${previous ? `<button type="button" data-vault-mission="${escapeHtml(previous.slug)}">← 上一关</button>` : ''}
            <button type="button" data-vault-return>回任务卡自检</button>
            ${following ? `<button type="button" data-vault-mission="${escapeHtml(following.module.slug)}">下一关 →</button>` : ''}
          </div>
          ${target.docMissing ? '<p class="juben-vault-mission-warning">本关指定档案暂未发布，已退到本卷首篇；可先在完整目录里自行查阅。</p>' : ''}
        </section>`;
    }

    function requestMission(caseId, moduleSlug, returnToTrainer = false) {
      pendingMission = { caseId, moduleSlug };
      directPrivateCase = null;
      window.dispatchEvent(new CustomEvent('atw-juben-request-mission', {
        detail: { ...pendingMission, hash: returnToTrainer ? '' : 'dm-vault' },
      }));
      if (returnToTrainer) {
        document.getElementById('juben-practice').open = true;
        document.getElementById('juben-trainer')?.scrollIntoView({ behavior: scrollBehavior(), block: 'center' });
      }
    }

    function renderReader(generation = beginVaultRender()) {
      if (!manifest || !isDm(user) || generation !== vaultGeneration) return;
      const identity = identityKey(user);
      const welcomed = new URLSearchParams(location.search).get('welcome') === '1';
      setState(`DM · ${displayNameOf(user)}${welcomed ? ' · 欢迎入门' : ''}`);
      const target = applyMissionTarget();
      body.innerHTML = `
        <div class="juben-vault-reader" id="vault-reader">
          <aside class="juben-vault-side">
            <details class="juben-vault-invite">
              <summary>我的邀请码</summary>
              <code id="vault-invite-code">${escapeHtml(inviteInfo ? inviteInfo.code : '……')}</code>
              <button type="button" id="vault-invite-copy">复制</button>
              <p class="juben-vault-invite-sub">把它交给值得信任的准 DM；每带一人进门，传承就长一格。</p>
            </details>
            <div class="juben-vault-cases" id="vault-cases" aria-label="卷宗"><p class="juben-vault-invite-title">卷宗</p></div>
          </aside>
          <div class="juben-vault-main">
            ${renderMissionBar()}
            ${renderDocList()}
            <article class="juben-vault-doc-body" id="vault-reader-doc" aria-live="polite"><p class="juben-vault-loading">取文中…</p></article>
          </div>
        </div>`;

      if (!inviteInfo) {
        api('GET', '/dm/invite').then((result) => {
          if (!isCurrentVault(generation, identity) || !isDm(user)) return;
          inviteInfo = result.invite;
          const code = document.getElementById('vault-invite-code');
          if (code) code.textContent = inviteInfo.code;
        }).catch(() => {});
      }

      document.getElementById('vault-invite-copy')?.addEventListener('click', async (event) => {
        const code = document.getElementById('vault-invite-code').textContent.trim();
        try {
          await navigator.clipboard.writeText(code);
          event.target.textContent = '已复制';
        } catch {
          event.target.textContent = '复制失败';
        }
        setTimeout(() => { if (event.target.isConnected) event.target.textContent = '复制'; }, 1500);
      });

      const casesHost = document.getElementById('vault-cases');
      if (manifest.cases.length) {
        manifest.cases.forEach((entry) => {
          const publicCase = jubenCases.find((item) => item.vaultCaseId === entry.id);
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'juben-vault-case' + (entry.id === activeCase ? ' is-active' : '');
          button.textContent = entry.id.replace(/^\d+-/, '');
          button.setAttribute('aria-pressed', String(entry.id === activeCase));
          button.addEventListener('click', () => {
            if (publicCase) requestMission(publicCase.id, publicCase.modules[0].slug);
            else {
              directPrivateCase = entry.id;
              renderReader();
            }
          });
          casesHost.append(button);
        });
      } else {
        const empty = document.createElement('p');
        empty.className = 'juben-vault-invite-sub';
        empty.textContent = manifest.configured ? '档案库还是空的：内容源还没有 cases/ 内容。' : '内容通道未配置（服务器缺 ATW_JUBEN_TOKEN），邀请码体系不受影响。';
        casesHost.append(empty);
      }

      document.querySelectorAll('.juben-vault-doc').forEach((button) => {
        button.addEventListener('click', () => openDoc(activeCase, button.dataset.doc));
      });
      document.querySelectorAll('[data-vault-mission]').forEach((button) => {
        button.addEventListener('click', () => requestMission(pendingMission.caseId, button.dataset.vaultMission));
      });
      document.querySelector('[data-vault-return]')?.addEventListener('click', () => requestMission(pendingMission.caseId, pendingMission.moduleSlug, true));

      if (activeDoc) openDoc(activeCase, activeDoc);
      else document.getElementById('vault-reader-doc').innerHTML = target && !target.manifestCase
        ? '<p class="juben-vault-msg" data-tone="error">这卷公开训练还没有对应的 DM 档案，未打开其他卷宗代替。</p>'
        : '<p class="juben-vault-loading">这一卷还没有文档。</p>';
    }

    async function renderForUser() {
      const generation = beginVaultRender();
      const identity = identityKey(user);
      if (!isDm(user)) {
        manifest = null;
        activeCase = null;
        activeDoc = null;
        directPrivateCase = null;
        inviteInfo = null;
      }
      if (!user) return renderAnonymous();
      if (!isDm(user)) return renderRedeem();
      setState('DM 档案库');
      body.innerHTML = '<p class="juben-vault-loading">正在读取档案目录…</p>';
      try {
        const loadedManifest = await loadManifest();
        if (!isCurrentVault(generation, identity) || !isDm(user)) return;
        manifest = loadedManifest;
        renderReader(generation);
      } catch (error) {
        if (!isCurrentVault(generation, identity)) return;
        body.innerHTML = `<p class="juben-vault-msg" data-tone="error">${escapeHtml(error.message || '档案库暂时打不开')}</p>`;
      }
    }

    window.addEventListener('atw-juben-mission', (event) => {
      const { caseId, moduleSlug } = event.detail || {};
      if (!caseId || !moduleSlug) return;
      pendingMission = { caseId, moduleSlug };
      directPrivateCase = null;
      if (!user) updateGateLinks();
      if (manifest && isDm(user) && document.getElementById('vault-reader')) renderReader();
    });

    onAuthChange((next) => {
      const token = getToken();
      const changed = sessionToken !== token || identityKey(user) !== identityKey(next);
      sessionToken = token;
      user = next;
      if (!changed) return;
      recentDocs.clear();
      manifest = null;
      activeCase = null;
      activeDoc = null;
      directPrivateCase = null;
      inviteInfo = null;
      renderForUser();
    });

    async function boot() {
      // 缓存只用于选择启动路径。目录接口本身每次都会在服务端核验 DM 权限。
      if (!sessionToken) {
        renderAnonymous();
        return;
      }
      if (isDm(user)) {
        void renderForUser();
        void refreshUser();
        return;
      }
      const generation = vaultGeneration;
      await refreshUser();
      if (!isCurrentVault(generation)) return;
      renderForUser();
    }

    boot();
  }
</script>

