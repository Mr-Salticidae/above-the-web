---
// 登录板块。只做一件事：把人认出来。注册在隔壁 /account/register/，个人中心在 /account/。
// 三种状态：选账号继续（本机存着的账号，一点就进）/ 输密码登录 / 已经登录着（提示并给切号入口）。
import BaseLayout from '../../../layouts/BaseLayout.astro';
// 没有邮件服务，也就没有自助重置密码。忘了密码只能找站长人工改，这里给个能找到人的地方。
const OWNER_URL = 'https://github.com/Mr-Salticidae';
---

<BaseLayout title="登录" description="登录蛛网之上：读站不需要账号，认领任务书才需要。" noindex>
  <div class="auth-page">
    <section class="auth-aside">
      <p class="auth-kicker">Sign in</p>
      <h1>登录</h1>
      <p class="auth-lead">
        读站、看快讯、翻笔记都不需要账号。只有认领任务书要登录——那头连着报酬和打款，
        得能把人对上。
      </p>
      <ul class="auth-points">
        <li>认领、交付、打款进度都记在你的账号下</li>
        <li>联系方式与收款方式只有你自己和发布方看得到</li>
        <li>同一台机器可以留多个账号，随时切换</li>
      </ul>
    </section>

    <section class="auth-card">
      <p class="auth-loading" data-view="loading">正在确认登录状态…</p>

      <!-- 已经登录着又访问登录页 -->
      <div class="auth-signed" data-view="signed-in" hidden>
        <p class="auth-card-title">你已经登录了</p>
        <div class="auth-current" data-current></div>
        <div class="auth-actions">
          <a class="atw-primary" data-continue href="#">继续</a>
          <button class="atw-ghost" type="button" data-use-other>换个账号登录</button>
        </div>
      </div>

      <!-- 选账号继续：本机存着的账号，免密 -->
      <div class="auth-chooser" data-view="chooser" hidden>
        <p class="auth-card-title">选择账号继续</p>
        <div class="auth-account-list" data-account-list></div>
        <button class="auth-switch-link" type="button" data-use-other>用其它账号登录</button>
      </div>

      <!-- 输密码 -->
      <div data-view="form" hidden>
        <p class="auth-card-title">输入账号密码</p>
        <form class="atw-form" data-form="login">
          <label>
            <span>用户名或邮箱</span>
            <input name="identifier" autocomplete="username" autocapitalize="off" spellcheck="false" required />
          </label>
          <label>
            <span>密码</span>
            <span class="auth-pw">
              <input name="password" type="password" autocomplete="current-password" required />
              <button class="auth-pw-toggle" type="button" data-toggle-pw aria-label="显示密码">显示</button>
            </span>
            <i class="auth-caps" data-caps hidden>大写锁定开着，注意密码大小写。</i>
          </label>
          <button class="atw-primary" type="submit">登录</button>
          <p class="atw-msg" data-msg="login" role="status"></p>
        </form>
        <p class="auth-alt" data-back-to-chooser hidden>
          <button class="auth-switch-link" type="button" data-show-chooser>← 回到已保存的账号</button>
        </p>
        <p class="auth-foot">
          还没有账号？<a data-register-link href="#">注册一个 →</a>
        </p>
        <p class="auth-foot auth-foot-dim">
          忘了密码？站内还没有自助重置，去 <a href={OWNER_URL} target="_blank" rel="noopener">GitHub</a> 找站长改。
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import {
    api,
    avatarHtml,
    currentNext,
    displayNameOf,
    escapeHtml,
    getCachedUser,
    getToken,
    listAccounts,
    refreshUser,
    registerUrl,
    setSession,
    switchAccount,
    url,
  } from '../../../scripts/account-core.js';

  const views = {
    loading: document.querySelector('[data-view="loading"]'),
    'signed-in': document.querySelector('[data-view="signed-in"]'),
    chooser: document.querySelector('[data-view="chooser"]'),
    form: document.querySelector('[data-view="form"]'),
  };
  const params = new URLSearchParams(location.search);
  const next = currentNext();
  // 从「用其它账号登录」进来的：本来就登录着，别把人弹回去
  const adding = params.get('add') === '1';
  const destination = next || url('account/');

  function show(name) {
    for (const [key, node] of Object.entries(views)) node.hidden = key !== name;
  }

  function say(text, ok = false) {
    const node = document.querySelector('[data-msg="login"]');
    node.textContent = text;
    node.dataset.tone = ok ? 'ok' : text ? 'error' : '';
  }

  function done() {
    location.replace(destination);
  }

  document.querySelector('[data-register-link]').href = registerUrl(next);

  // ---------- 已保存的账号 ----------

  function renderAccounts(accounts) {
    document.querySelector('[data-account-list]').innerHTML = accounts
      .map(
        (account) => `<button class="auth-account" type="button" data-switch="${escapeHtml(
          account.userId,
        )}">
          ${avatarHtml(account.user, 'lg')}
          <span class="auth-account-text">
            <span class="auth-account-name">${escapeHtml(displayNameOf(account.user))}</span>
            <span class="auth-account-sub">@${escapeHtml(account.user.username)}</span>
          </span>
          <span class="auth-account-go" aria-hidden="true">→</span>
        </button>`,
      )
      .join('');
  }

  document.querySelector('[data-account-list]').addEventListener('click', async (event) => {
    const button = event.target.closest('[data-switch]');
    if (!button) return;
    button.disabled = true;
    const user = await switchAccount(button.dataset.switch);
    if (user) {
      done();
      return;
    }
    // 令牌已经失效：退回表单，用户名先填好
    button.disabled = false;
    const stale = listAccounts();
    if (stale.length) renderAccounts(stale);
    show('form');
    say('这个账号的登录态过期了，重新输一次密码。');
  });

  document.querySelectorAll('[data-use-other]').forEach((button) => {
    button.addEventListener('click', () => {
      show('form');
      document.querySelector('[name="identifier"]').focus();
    });
  });

  document.querySelector('[data-show-chooser]').addEventListener('click', () => {
    say('');
    show('chooser');
  });

  // ---------- 表单 ----------

  const password = document.querySelector('[name="password"]');

  document.querySelector('[data-toggle-pw]').addEventListener('click', (event) => {
    const shown = password.type === 'text';
    password.type = shown ? 'password' : 'text';
    event.target.textContent = shown ? '显示' : '隐藏';
    event.target.setAttribute('aria-label', shown ? '显示密码' : '隐藏密码');
    password.focus();
  });

  password.addEventListener('keyup', (event) => {
    const caps = event.getModifierState?.('CapsLock');
    document.querySelector('[data-caps]').hidden = !caps;
  });

  document.querySelector('[data-form="login"]').addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = event.target.querySelector('button[type="submit"]');
    button.disabled = true;
    say('登录中…');
    try {
      const payload = await api('POST', '/auth/login', {
        identifier: event.target.identifier.value,
        password: event.target.password.value,
      });
      setSession(payload);
      done();
    } catch (error) {
      button.disabled = false;
      say(error.message);
    }
  });

  // ---------- 入口 ----------

  async function boot() {
    const accounts = listAccounts();
    const others = accounts.filter((account) => !account.isActive);

    if (getToken() && !adding) {
      const user = (await refreshUser()) || getCachedUser();
      if (user) {
        document.querySelector('[data-current]').innerHTML = `${avatarHtml(user, 'lg')}
          <span class="auth-account-text">
            <span class="auth-account-name">${escapeHtml(displayNameOf(user))}</span>
            <span class="auth-account-sub">@${escapeHtml(user.username)}</span>
          </span>`;
        document.querySelector('[data-continue]').href = destination;
        show('signed-in');
        return;
      }
    }

    // 加登录时先给「切到已有账号」的机会，不然多账号的人得一个个输密码
    const pickable = adding ? others : accounts;
    document.querySelector('[data-back-to-chooser]').hidden = !pickable.length;
    if (pickable.length) {
      renderAccounts(pickable);
      show('chooser');
      return;
    }
    show('form');
  }

  boot();
</script>
