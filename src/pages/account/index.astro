---
// 个人中心。登录后才有内容——没登录直接送去 /account/login/，登完回来。
// 登录与注册各自成板块（account/login、account/register），这一页只管「登录之后的事」：
// 概览与身份 / 资料 / 安全（改密码、登录设备、本机账号切换、退出）。
//
// 站点重心从「接单」挪到「读」与「剧本」之后，概览首屏按身份分流：
// DM 看档案库与学习进度，读者看能去哪、怎么拿到 DM 身份。
// 任务书那套（认领记录、收款资料）只在 TASKS_ENABLED 打开时才出现（src/data/features.js）。
import BaseLayout from '../../layouts/BaseLayout.astro';
import { jubenCases } from '../../data/juben.js';
import { TASKS_ENABLED } from '../../data/features.js';

// 学习进度先写本机 localStorage，按账号分桶，并在开关允许时跨设备同步。
// 这里把卷名与模块 slug 带到前端，用来算完成率和定位下一关。
const progressSeed = jubenCases.map((item) => ({
  id: item.id,
  title: item.title,
  modules: Array.isArray(item.modules) ? item.modules.map((module) => module.slug) : [],
}));
---

<BaseLayout title="个人中心" description="蛛网之上的站内账号：身份、剧本档案与登录安全。" noindex>
  <div class="account-page">
    <p class="acc-loading" data-view="loading">正在确认登录状态…</p>

    <div data-view="ready" hidden>
      <header class="acc-head">
        <div class="acc-id" data-identity></div>
        <div class="acc-head-actions">
          <a class="atw-ghost" href="#" data-admin-link hidden>管理台</a>
          <button class="atw-ghost" type="button" data-logout>退出登录</button>
        </div>
      </header>

      <nav class="acc-tabs" role="tablist" aria-label="账号设置">
        <button class="acc-tab is-active" type="button" role="tab" data-tab="overview">概览</button>
        <button class="acc-tab" type="button" role="tab" data-tab="profile">资料</button>
        <button class="acc-tab" type="button" role="tab" data-tab="security">安全</button>
      </nav>

      <!-- 概览：先说你是什么身份、能去哪；任务书只在开关打开时才出现 -->
      <section class="acc-panel" data-panel="overview">
        <div data-home><p class="atw-empty">加载中…</p></div>

        {TASKS_ENABLED && (
          <>
            <div class="acc-stats" data-stats></div>

            <h2 id="claims">我的认领</h2>
            <p class="acc-note">
              申请、定人、交付、打款的进度都在这儿。发布方定了人之后，会直接按你填的联系方式找你。
            </p>
            <div data-claims><p class="atw-empty">加载中…</p></div>
          </>
        )}
      </section>

      <!-- 资料 -->
      <section class="acc-panel" data-panel="profile" hidden>
        <h2>资料</h2>
        <p class="acc-note">
          昵称会出现在评论、邀请与登录列表里；用户名只作登录用，改不了。
        </p>
        <form class="atw-form" data-form="profile">
          <label>
            <span>用户名<i>登录用，不可修改</i></span>
            <input name="username" disabled />
          </label>
          <label>
            <span>昵称<i>公开显示</i></span>
            <input name="displayName" maxlength="32" />
          </label>
          <label>
            <span>一句话简介<i>可留空</i></span>
            <input name="bio" maxlength="200" />
          </label>
          <details class="acc-fold" open={TASKS_ENABLED}>
            <summary>合作资料（联系方式与收款方式）</summary>
            <p class="acc-note">
              {TASKS_ENABLED
                ? '只有你自己和发布方看得到，不出现在任何公开页面、也不进任何公开接口。'
                : '任务书版块暂时收起，这两项先当占位留着；将来重启对外合作时才会用到，不填也不影响现在的一切。'}
            </p>
            <label>
              <span>联系方式<i>微信号 / QQ / 邮箱，能找到你就行</i></span>
              <input name="contact" maxlength="120" />
            </label>
            <label>
              <span>收款方式<i>微信 / 支付宝账号，打款时用</i></span>
              <input name="payee" maxlength="120" />
            </label>
          </details>
          <button class="atw-primary" type="submit">保存资料</button>
          <p class="atw-msg" data-msg="profile" role="status"></p>
        </form>
      </section>

      <!-- 安全 -->
      <section class="acc-panel" data-panel="security" hidden>
        <h2>改密码</h2>
        <form class="atw-form" data-form="password">
          <label>
            <span>当前密码</span>
            <input name="currentPassword" type="password" autocomplete="current-password" required />
          </label>
          <label>
            <span>新密码<i>8 位以上；改完其它设备会被踢下线，这台不受影响</i></span>
            <input name="newPassword" type="password" autocomplete="new-password" required minlength="8" />
          </label>
          <button class="atw-primary" type="submit">更新密码</button>
          <p class="atw-msg" data-msg="password" role="status"></p>
        </form>

        <h2>登录设备</h2>
        <p class="acc-note">
          每次登录算一个会话。看到不认识的，退掉它——那台设备上的登录立刻作废。
        </p>
        <div data-sessions><p class="atw-empty">加载中…</p></div>
        <p class="atw-msg" data-msg="sessions" role="status"></p>

        <h2>这台机器上的账号</h2>
        <p class="acc-note">
          浏览器里可以同时留几个账号，切换不用重输密码。「移除」只把令牌从这台机器上抹掉，
          账号本身不动；「退出登录」会连服务端的这次会话一起吊销。
        </p>
        <div data-accounts></div>
        <div class="acc-danger">
          <a class="atw-ghost" href="#" data-add-account>用其它账号登录</a>
          <button class="atw-ghost" type="button" data-logout-all>退出所有设备</button>
        </div>
        <p class="atw-msg" data-msg="accounts" role="status"></p>
      </section>
    </div>
  </div>

  <!-- 卷名与模块数：前端据此把本机学习进度换算成完成率 -->
  <script type="application/json" id="juben-cases" set:html={JSON.stringify(progressSeed)} />
</BaseLayout>

<script>
  import {
    api,
    avatarHtml,
    cacheUser,
    displayNameOf,
    escapeHtml,
    forgetAccount,
    formatDate,
    formatDateTime,
    getCachedUser,
    getToken,
    listAccounts,
    loginUrl,
    refreshUser,
    requireSignIn,
    signOut,
    switchAccount,
    url,
    isDm,
    ROLE_HINT,
    ROLE_LABEL,
    TASK_STATUS_LABEL,
  } from '../../scripts/account-core.js';
  import { createProgressStore, GUEST_OWNER } from '../../scripts/progress-store.js';
  import { createProgressSync, mountBadge, relativeTime } from '../../scripts/progress-sync.js';
  import { PROGRESS_SYNC } from '../../data/features.js';

  const CLAIM_LABEL = {
    pending: '等发布方定人',
    accepted: '已定给你',
    rejected: '没选上',
    withdrawn: '你已撤回',
  };

  let me = null;

  function say(key, text, tone = 'error') {
    const node = document.querySelector(`[data-msg="${key}"]`);
    if (!node) return;
    node.textContent = text;
    // 三种口吻：busy 进行中/ok 成功/error 出错——「保存中…」不该是红的
    node.dataset.tone = text ? tone : '';
  }

  // ---------- 标签页 ----------

  const TABS = ['overview', 'profile', 'security'];

  function selectTab(name) {
    const tab = TABS.includes(name) ? name : 'overview';
    document.querySelectorAll('[data-tab]').forEach((node) => {
      const on = node.dataset.tab === tab;
      node.classList.toggle('is-active', on);
      node.setAttribute('aria-selected', String(on));
    });
    document.querySelectorAll('[data-panel]').forEach((node) => {
      node.hidden = node.dataset.panel !== tab;
    });
  }

  document.querySelectorAll('[data-tab]').forEach((node) => {
    node.addEventListener('click', () => {
      selectTab(node.dataset.tab);
      history.replaceState(null, '', `#${node.dataset.tab}`);
    });
  });

  function tabFromHash() {
    const hash = location.hash.replace('#', '');
    // #claims 是概览里的锚点，别当成第四个标签页
    return hash === 'claims' ? 'overview' : hash;
  }

  window.addEventListener('hashchange', () => selectTab(tabFromHash()));

  // ---------- 渲染 ----------

  function renderIdentity(user) {
    // 三种身份都挂徽章：读者也要知道自己现在是哪一档，不然会以为「怎么什么都没解锁」
    const badge = user.role === 'dm'
      ? `<span class="acct-badge is-dm">${ROLE_LABEL.dm}</span>`
      : user.role === 'admin'
        ? `<span class="acct-badge">${ROLE_LABEL.admin}</span>`
        : `<span class="acct-badge is-reader">${ROLE_LABEL.member}</span>`;
    const role = badge;
    document.querySelector('[data-identity]').innerHTML = `${avatarHtml(user, 'xl')}
      <div class="acc-id-text">
        <h1>${escapeHtml(displayNameOf(user))}${role}</h1>
        <p class="acc-id-sub">@${escapeHtml(user.username)} · ${escapeHtml(user.email)}</p>
      </div>`;
    const adminLink = document.querySelector('[data-admin-link]');
    adminLink.hidden = user.role !== 'admin';
    adminLink.href = url('admin/');
    document.querySelector('[data-add-account]').href = loginUrl(location.pathname, { add: true });

    const form = document.querySelector('[data-form="profile"]');
    form.username.value = user.username;
    form.displayName.value = user.display_name || '';
    form.contact.value = user.contact || '';
    form.payee.value = user.payee || '';
    form.bio.value = user.bio || '';
  }

  // ---------- 概览：身份与去处 ----------

  // 卷名与模块数由服务端在构建期塞进页面（见 frontmatter 的 progressSeed）
  const CASES = (() => {
    try {
      return JSON.parse(document.getElementById('juben-cases')?.textContent || '[]') || [];
    } catch {
      return [];
    }
  })();
  // 与 /juben/ 共用同一个仓库（src/scripts/progress-store.js），按账号分桶：
  // 这台上切过几个号，各看各的。owner 在 renderHome 里按当前用户重绑。
  // 同步层（progress-sync.js）在页面底部初始化，勾选与进度条都还读本地，网络只是对账。
  const progress = createProgressStore({ cases: CASES, owner: GUEST_OWNER });
  progress.boot();
  let inviteInfo = null;
  let sync = null;
  let badgeOff = null;
  let syncOff = null;

  /** 把同步状态写进状态卡。节点来自 innerHTML 重画，所以要容错缺失。 */
  function paintSyncCard(status) {
    const host = document.querySelector('[data-sync-card]');
    if (!host || !status) return;
    const when = host.querySelector('[data-sync-when]');
    if (when) {
      when.textContent = status.lastSyncAt
        ? relativeTime(status.lastSyncAt)
        : status.state === 'syncing'
          ? '同步中…'
          : '还没同步过';
    }
    const pending = host.querySelector('[data-sync-pending]');
    if (pending) pending.textContent = status.pending ? `${status.pending} 项` : '0 项';
    const devices = host.querySelector('[data-sync-devices]');
    if (devices) devices.textContent = status.devices ? `${status.devices} 台` : '这台';
    const wipe = host.querySelector('[data-sync-wipe]');
    // 清空要联网才有意义：离线时它只会清本地，别的设备下次把进度推回来又长出来
    if (wipe) wipe.disabled = status.state === 'syncing';
  }

  function vaultBlock() {
    const rows = CASES.map((item) => {
      const done = progress.count(item.id);
      const total = Array.isArray(item.modules) ? item.modules.length : 0;
      return {
        id: item.id,
        title: item.title,
        done,
        total,
        next: item.modules.find((slug) => !progress.isDone(item.id, slug)) || item.modules[0],
        pct: total ? Math.min(100, Math.round((done / total) * 100)) : 0,
      };
    });
    const doneAll = rows.reduce((sum, row) => sum + row.done, 0);
    const totalAll = rows.reduce((sum, row) => sum + row.total, 0);
    const pctAll = totalAll ? Math.round((doneAll / totalAll) * 100) : 0;
    const list = rows
      .map(
        (row) => `<a class="acc-vault-row" href="${url('juben/')}?case=${encodeURIComponent(row.id)}&module=${encodeURIComponent(row.next)}">
          <span class="acc-vault-name">${escapeHtml(row.title)}</span>
          <span class="acc-vault-bar"><i style="width:${row.pct}%"></i></span>
          <span class="acc-vault-num">${row.done}/${row.total}</span>
        </a>`,
      )
      .join('');
    // 有没有同步层决定这句话怎么说：别在没有的能力上写承诺
    const syncNote = sync && sync.enabled
      ? '进度跟着账号走：换台设备登录同一个账号，勾选原样接着读。'
      : '进度记在这台机器上的这个账号里，换设备暂时不跟着走。';

    return `<section class="acc-home-block">
        <h2>我的档案库 <button class="acc-sync" type="button" id="acc-sync-badge" hidden>本机记录</button> <a class="acc-home-more" href="${url('juben/')}">进档案库 →</a></h2>
        <p class="acc-note">${syncNote}点卷名直接从那一卷接着读。</p>
        <div class="acc-vault-total">
          <b>${pctAll}%</b>
          <span>全部学习项完成 · ${doneAll}/${totalAll}</span>
        </div>
        <div class="acc-vault-rows">${list || '<p class="atw-empty">暂时没有可读的卷宗。</p>'}</div>
        ${resumeHtml()}
        <div class="acc-invite">
          <p class="acc-invite-label">我的邀请码</p>
          <code id="acc-invite-code">${escapeHtml(inviteInfo ? inviteInfo.code : '……')}</code>
          <button class="atw-ghost" type="button" data-copy-invite>复制</button>
          <p class="acc-invite-hint">交给值得信任的准 DM；每带一人进门，传承就长一格。</p>
        </div>
        ${syncCardHtml()}
      </section>`;
  }

  /** 「上次读到哪一卷」：和完成率读同一份仓库，只是那条记录走保留卷名 reading。 */
  function resumeHtml() {
    const last = progress.lastReading();
    if (!last) return '';
    const item = CASES.find((entry) => entry.id === last.caseId);
    const title = item?.title || last.caseId;
    const next = item?.modules.find((slug) => !progress.isDone(last.caseId, slug)) || item?.modules[0];
    const href = `${url('juben/')}?case=${encodeURIComponent(last.caseId)}${next ? `&module=${encodeURIComponent(next)}` : ''}`;
    return `<p class="acc-resume">上次读到《${escapeHtml(title)}》 · ${relativeTime(last.at)}
      <a href="${href}">接着读 →</a></p>`;
  }

  /**
   * 档案库底部的同步状态卡：上次同步 / 待同步 / 设备数，外加手动同步与清空。
   * 清空是唯一不可撤销的动作，所以那一个按钮要点两次（不做弹窗，弹窗会打断读的人）。
   */
  function syncCardHtml() {
    if (!sync || !sync.enabled) {
      return `<div class="acc-sync-card is-local" data-sync-card="local">
        <p class="acc-sync-title">进度目前只记在这台机器上</p>
        <p class="acc-sync-hint">跨设备同步关着（服务端开关或接口版本所致）；勾选照旧有效，只是不跟着账号走。</p>
        <div class="acc-sync-actions">
          <button class="atw-ghost" type="button" data-sync-wipe>清空本机进度</button>
        </div>
        <p class="acc-sync-hint" data-sync-hint></p>
      </div>`;
    }
    return `<div class="acc-sync-card" data-sync-card="cloud">
      <div class="acc-sync-facts">
        <p><span>上次同步</span><b data-sync-when>—</b></p>
        <p><span>待同步</span><b data-sync-pending>0 项</b></p>
        <p><span>记录过的设备</span><b data-sync-devices>—</b></p>
      </div>
      <div class="acc-sync-actions">
        <button class="atw-ghost" type="button" data-sync-now>立即同步</button>
        <button class="atw-ghost" type="button" data-sync-wipe>清空全部进度</button>
      </div>
      <p class="acc-sync-hint">勾选先存本机，联网后自动对账。同一账号在别的设备上打开，会接着同一处读。</p>
      <p class="acc-sync-hint" data-sync-hint></p>
    </div>`;
  }

  function readerBlock() {
    return `<section class="acc-home-block">
        <h2>你手上还没有剧本档案</h2>
        <p class="acc-note">
          剧本的答案、组织者手册、结局解析都不在公开页上。DM 身份是传出来的——
          找一位已经在带本的朋友要一枚邀请码，在剧本研究室兑换即可，不用另外申请。
        </p>
        <p class="acc-home-actions">
          <a class="atw-primary" href="${url('juben/')}">去剧本研究室</a>
          <a class="atw-ghost" href="${url('notes/')}">翻笔记</a>
        </p>
        <p class="acc-note">
          读者身份现在就能用：笔记全文搜索、在笔记里对着「小织」追问，以及分栏订阅。
          兑换邀请码的表单也在剧本研究室里，登录后就能看到。
        </p>
        ${resumeHtml()}
      </section>`;
  }

  function renderHome(user) {
    const host = document.querySelector('[data-home]');
    if (!host) return;
    const dm = isDm(user);
    // 先绑到本人桶：老版本那把全站共用的钥匙，切号会让两个账号看见彼此。
    // 同步层要排在仓库之前换人，否则上一个账号的待推项会被记到新账号名下。
    if (sync) sync.setOwner(user.id || GUEST_OWNER);
    progress.setOwner(user.id || GUEST_OWNER);
    progress.adoptGuest(); // 未登录时在剧本研究室勾的，登录后并进来
    if (sync) sync.note();
    host.innerHTML = dm ? vaultBlock() : readerBlock();
    if (dm && sync) {
      const badge = host.querySelector('#acc-sync-badge');
      if (badge) {
        badge.hidden = false;
        badgeOff?.();
        badgeOff = mountBadge(badge, sync);
      }
    }
    // 状态卡每次重画都是一批新节点，订阅也要跟着换，别越挂越多
    if (sync) {
      paintSyncCard(sync.status());
      syncOff?.();
      syncOff = sync.subscribe(paintSyncCard);
    }
    if (dm && !inviteInfo) {
      api('GET', '/dm/invite')
        .then((result) => {
          inviteInfo = result.invite;
          const node = document.getElementById('acc-invite-code');
          if (node && inviteInfo) node.textContent = inviteInfo.code;
        })
        .catch(() => {});
    }
  }

  document.addEventListener('click', async (event) => {
    const button = event.target.closest('[data-copy-invite]');
    if (!button) return;
    const code = document.getElementById('acc-invite-code')?.textContent.trim() || '';
    try {
      await navigator.clipboard.writeText(code);
      button.textContent = '已复制';
    } catch {
      button.textContent = '复制失败';
    }
    setTimeout(() => {
      button.textContent = '复制';
    }, 1500);
  });

  // ---------- 状态卡：手动同步 / 清空 ----------

  const wipeLabel = () => (sync && sync.enabled ? '清空全部进度' : '清空本机进度');
  let wipeArmed = false;
  let wipeTimer = null;

  document.addEventListener('click', async (event) => {
    const nowButton = event.target.closest('[data-sync-now]');
    if (nowButton) {
      if (!sync) return;
      nowButton.disabled = true;
      await sync.syncNow();
      nowButton.disabled = false;
      const hint = document.querySelector('[data-sync-hint]');
      if (hint) {
        hint.textContent = ['error', 'pending'].includes(sync.status().state)
          ? '这次没对上，检查网络后再点一次。'
          : '已对齐。别的设备上的改动也一并取回来了。';
      }
      return;
    }

    const wipe = event.target.closest('[data-sync-wipe]');
    if (!wipe) return;

    // 第一次点只是「上膛」，四秒不点自动收回——清空不可撤销，但也不该弹窗打断阅读
    if (!wipeArmed) {
      wipeArmed = true;
      wipe.dataset.armed = '1';
      wipe.textContent = '真的清空？再点一次';
      clearTimeout(wipeTimer);
      wipeTimer = setTimeout(() => {
        wipeArmed = false;
        const node = document.querySelector('[data-sync-wipe]');
        if (node) {
          delete node.dataset.armed;
          node.textContent = wipeLabel();
        }
      }, 4000);
      return;
    }

    wipeArmed = false;
    clearTimeout(wipeTimer);
    wipe.disabled = true;
    wipe.textContent = '清空中…';
    let resetOk = true;
    if (sync && sync.enabled) resetOk = await sync.reset();
    else progress.clearAll();
    renderHome(me);
    const hint = document.querySelector('[data-sync-hint]');
    if (hint) {
      hint.textContent = !resetOk
        ? '清空失败：本机记录和待同步内容都还在。请检查网络后重试。'
        : sync && sync.enabled
          ? '已清空。别的设备下次打开会跟着归零。'
          : '已清空本机记录。';
    }
  });

  function renderStats(user, claims) {
    const running = claims.filter((claim) => claim.status === 'accepted').length;
    const waiting = claims.filter((claim) => claim.status === 'pending').length;
    const missing = [
      !user.contact ? '联系方式' : '',
      !user.payee ? '收款方式' : '',
    ].filter(Boolean);
    const todo = missing.length
      ? `<a class="acc-stat is-todo" href="#profile">还差${missing.join('、')}<span>去补上 →</span></a>`
      : '';
    document.querySelector('[data-stats]').innerHTML = `
      <div class="acc-stat"><b>${claims.length}</b><span>累计申请</span></div>
      <div class="acc-stat"><b>${waiting}</b><span>等定人</span></div>
      <div class="acc-stat"><b>${running}</b><span>已定给你</span></div>
      <div class="acc-stat is-date"><b>${formatDate(user.created_at) || '—'}</b><span>注册于</span></div>
      ${todo}`;
  }

  function renderClaims(claims) {
    const host = document.querySelector('[data-claims]');
    if (!claims.length) {
      host.innerHTML = `<p class="atw-empty">还没有认领记录。去<a href="${url(
        'tasks/',
      )}">任务书</a>看看有什么在招。</p>`;
      return;
    }
    host.innerHTML = claims
      .map((claim) => {
        const taskUrl = url(`tasks/${claim.taskSlug}/`);
        const note = claim.decideNote
          ? `<p class="atw-claim-note">发布方留言：${escapeHtml(claim.decideNote)}</p>`
          : '';
        return `<article class="atw-claim">
          <div class="atw-claim-top">
            <span class="atw-claim-status is-${claim.status}">${
              CLAIM_LABEL[claim.status] || claim.status
            }</span>
            <span class="atw-claim-date">${formatDate(claim.createdAt)} 申请</span>
          </div>
          <h3><a href="${taskUrl}">${escapeHtml(claim.taskTitle || claim.taskSlug)}</a></h3>
          <p class="atw-claim-meta">
            任务当前：${TASK_STATUS_LABEL[claim.taskStatus] || claim.taskStatus}
            ${claim.taskFee ? ` · ${escapeHtml(claim.taskFee)}` : ''}
          </p>
          ${note}
        </article>`;
      })
      .join('');
  }

  function renderSessions(sessions) {
    const host = document.querySelector('[data-sessions]');
    if (!sessions.length) {
      host.innerHTML = '<p class="atw-empty">没有其它登录中的会话。</p>';
      return;
    }
    host.innerHTML = sessions
      .map(
        (session) => `<div class="acc-session${session.current ? ' is-current' : ''}">
          <div>
            <p class="acc-session-name">${session.current ? '当前设备' : '另一处登录'}</p>
            <p class="acc-session-meta">${formatDateTime(session.createdAt)} 登录 · ${formatDate(
              session.expiresAt,
            )} 到期</p>
          </div>
          <button class="atw-ghost" type="button" data-revoke="${escapeHtml(session.id)}">${
            session.current ? '退出这台' : '退掉'
          }</button>
        </div>`,
      )
      .join('');
  }

  function renderAccounts() {
    const accounts = listAccounts();
    document.querySelector('[data-accounts]').innerHTML = accounts
      .map(
        (account) => `<div class="acc-account${account.isActive ? ' is-current' : ''}">
          ${avatarHtml(account.user)}
          <div class="acc-account-text">
            <p class="acc-account-name">${escapeHtml(displayNameOf(account.user))}${
              account.isActive ? '<span class="acc-account-tag">当前</span>' : ''
            }</p>
            <p class="acc-account-sub">@${escapeHtml(account.user.username)}</p>
          </div>
          ${
            account.isActive
              ? ''
              : `<span class="acc-account-actions">
                  <button class="atw-ghost" type="button" data-switch="${escapeHtml(
                    account.userId,
                  )}">切到这个</button>
                  <button class="atw-ghost" type="button" data-forget="${escapeHtml(
                    account.userId,
                  )}">移除</button>
                </span>`
          }
        </div>`,
      )
      .join('');
  }

  // ---------- 动作 ----------

  document.querySelector('[data-form="profile"]').addEventListener('submit', async (event) => {
    event.preventDefault();
    say('profile', '保存中…', 'busy');
    const form = event.target;
    try {
      const { user } = await api('PATCH', '/profile', {
        displayName: form.displayName.value,
        contact: form.contact.value,
        payee: form.payee.value,
        bio: form.bio.value,
      });
      me = user;
      cacheUser(user);
      renderIdentity(user);
      renderAccounts();
      say('profile', '已保存', 'ok');
    } catch (error) {
      say('profile', error.message);
    }
  });

  document.querySelector('[data-form="password"]').addEventListener('submit', async (event) => {
    event.preventDefault();
    say('password', '更新中…', 'busy');
    try {
      await api('POST', '/auth/password', {
        currentPassword: event.target.currentPassword.value,
        newPassword: event.target.newPassword.value,
      });
      event.target.reset();
      say('password', '密码已更新，其它设备已退出', 'ok');
      loadSessions();
    } catch (error) {
      say('password', error.message);
    }
  });

  document.querySelector('[data-sessions]').addEventListener('click', async (event) => {
    const button = event.target.closest('[data-revoke]');
    if (!button) return;
    button.disabled = true;
    say('sessions', '处理中…', 'busy');
    try {
      const { current } = await api('DELETE', `/auth/sessions/${encodeURIComponent(button.dataset.revoke)}`);
      if (current) {
        // 把自己这台退了，就地清干净再送回登录页
        await signOut();
        location.href = loginUrl(location.pathname);
        return;
      }
      say('sessions', '已退出那一处登录', 'ok');
      loadSessions();
    } catch (error) {
      button.disabled = false;
      say('sessions', error.message);
    }
  });

  document.querySelector('[data-accounts]').addEventListener('click', async (event) => {
    const switchTo = event.target.closest('[data-switch]');
    if (switchTo) {
      switchTo.disabled = true;
      say('accounts', '切换中…', 'busy');
      const user = await switchAccount(switchTo.dataset.switch);
      if (user) location.reload();
      else location.href = loginUrl(location.pathname);
      return;
    }
    const forget = event.target.closest('[data-forget]');
    if (forget) {
      forgetAccount(forget.dataset.forget);
      renderAccounts();
      say('accounts', '已从这台机器上移除', 'ok');
    }
  });

  document.querySelector('[data-logout]').addEventListener('click', async (event) => {
    event.target.disabled = true;
    const { remaining } = await signOut();
    // 还留着别的账号就回登录页选一个，否则回首页
    location.href = remaining ? loginUrl('') : url('');
  });

  document.querySelector('[data-logout-all]').addEventListener('click', async (event) => {
    if (!confirm('退出所有设备？这个账号在别处的登录会立刻作废。')) return;
    event.target.disabled = true;
    await signOut({ everywhere: true });
    location.href = url('');
  });

  // ---------- 加载 ----------

  async function loadSessions() {
    try {
      const { sessions } = await api('GET', '/auth/sessions');
      renderSessions(sessions);
    } catch (error) {
      document.querySelector('[data-sessions]').innerHTML =
        '<p class="atw-empty">会话列表暂时读不到。</p>';
    }
  }

  async function boot() {
    if (!getToken()) {
      requireSignIn();
      return;
    }
    // 缓存先上屏，避免白一下；随后用服务端的权威资料覆盖
    const cached = getCachedUser();
    if (cached) {
      me = cached;
      renderIdentity(cached);
      renderHome(cached);
      document.querySelector('[data-view="loading"]').hidden = true;
      document.querySelector('[data-view="ready"]').hidden = false;
    }
    const user = await refreshUser();
    if (!user) {
      requireSignIn();
      return;
    }
    me = user;
    renderIdentity(user);
    renderHome(user);
    renderAccounts();
    selectTab(tabFromHash());
    document.querySelector('[data-view="loading"]').hidden = true;
    document.querySelector('[data-view="ready"]').hidden = false;
    if (location.hash === '#claims') {
      document.getElementById('claims')?.scrollIntoView({ block: 'start' });
    }

    // 任务书收起时页面里没有认领区块，就别去敲那个接口了
    const claimsHost = document.querySelector('[data-claims]');
    if (claimsHost) {
      try {
        const { claims } = await api('GET', '/my/claims');
        renderClaims(claims);
        renderStats(user, claims);
      } catch {
        claimsHost.innerHTML = '<p class="atw-empty">认领记录暂时读不到，刷新试试。</p>';
        renderStats(user, []);
      }
    }
    loadSessions();
  }

  // 进度跨设备同步：本地先认，网络只是对账。开关以服务端 /api/meta 为准，
  // 接口不在（旧版部署）或被人为关掉都静默退回纯本地，页面上看不出少了一块。
  async function startSync() {
    if (!PROGRESS_SYNC || !me) return;
    let allowed = true;
    try {
      const meta = await api('GET', '/meta');
      allowed = meta?.features?.progressSync !== false;
    } catch {
      allowed = true;
    }
    if (!allowed) return;
    sync = createProgressSync(progress, { request: api, owner: progress.owner });
    sync.start();
    // 文案与徽章都要按「现在有同步了」重画一遍
    renderHome(me);
    // 首轮拉取回来之后才有别的设备的进度与「上次读到」，再画一次
    sync.syncNow().then(() => {
      if (me) renderHome(me);
    });
    window.addEventListener('online', () => sync && sync.syncNow());
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && sync) sync.syncNow();
    });
  }

  boot().finally(startSync);
</script>
