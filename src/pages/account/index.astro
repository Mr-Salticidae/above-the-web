---
// 账号页：一页三态——加载中 / 未登录（登录·注册）/ 已登录（资料·我的认领·改密码）。
// 全站只有这里和任务认领用得上账号，读站的人永远不会被拦到这一页。
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="账号" description="蛛网之上的站内账号：读站不需要，认领任务才需要。">
  <div class="account-page">
    <header class="masthead">
      <p class="masthead-kicker">Account</p>
      <h1>账号</h1>
      <p class="masthead-desc">
        读站、看快讯、翻笔记都不需要账号。只有认领任务书要登录——那头连着报酬和打款，
        得能把人对上。
      </p>
    </header>

    <p class="loading" data-view="loading">正在确认登录状态…</p>

    <!-- 未登录 -->
    <section class="panel" data-view="anonymous" hidden>
      <div class="tabs" role="tablist">
        <button type="button" class="tab is-active" data-tab="login" role="tab">登录</button>
        <button type="button" class="tab" data-tab="register" role="tab">注册</button>
      </div>

      <form class="atw-form" data-form="login">
        <label>
          <span>用户名或邮箱</span>
          <input name="identifier" autocomplete="username" required />
        </label>
        <label>
          <span>密码</span>
          <input name="password" type="password" autocomplete="current-password" required />
        </label>
        <button class="atw-primary" type="submit">登录</button>
        <p class="atw-msg" data-msg="login" role="status"></p>
      </form>

      <form class="atw-form" data-form="register" hidden>
        <label>
          <span>用户名<i>登录用，2–32 位字母数字或 - _</i></span>
          <input name="username" autocomplete="username" required pattern="[A-Za-z0-9_-]{2,32}" />
        </label>
        <label>
          <span>昵称<i>公开显示，比如任务定给你之后</i></span>
          <input name="displayName" autocomplete="nickname" maxlength="32" />
        </label>
        <label>
          <span>邮箱</span>
          <input name="email" type="email" autocomplete="email" required />
        </label>
        <label>
          <span>密码<i>8 位以上</i></span>
          <input name="password" type="password" autocomplete="new-password" required minlength="8" />
        </label>
        <label data-invite hidden>
          <span>邀请码</span>
          <input name="inviteCode" />
        </label>
        <button class="atw-primary" type="submit">注册并登录</button>
        <p class="atw-msg" data-msg="register" role="status"></p>
      </form>
    </section>

    <!-- 已登录 -->
    <section class="panel" data-view="signed-in" hidden>
      <div class="whoami">
        <div>
          <p class="who-name" data-who-name></p>
          <p class="who-meta" data-who-meta></p>
        </div>
        <div class="who-actions">
          <a class="atw-ghost" href={`${base}admin/`} data-admin-link hidden>管理台</a>
          <button class="atw-ghost" type="button" data-logout>退出登录</button>
        </div>
      </div>

      <h2>资料</h2>
      <p class="section-note">
        联系方式和收款方式只有你自己和发布方看得到，不出现在任何公开页面上。
        认领任务前建议先填好，定了人当天就能对接。
      </p>
      <form class="atw-form" data-form="profile">
        <label>
          <span>昵称</span>
          <input name="displayName" maxlength="32" />
        </label>
        <label>
          <span>联系方式<i>微信号 / QQ / 邮箱，能找到你就行</i></span>
          <input name="contact" maxlength="120" />
        </label>
        <label>
          <span>收款方式<i>微信 / 支付宝账号，打款时用</i></span>
          <input name="payee" maxlength="120" />
        </label>
        <label>
          <span>一句话简介<i>可留空</i></span>
          <input name="bio" maxlength="200" />
        </label>
        <button class="atw-primary" type="submit">保存资料</button>
        <p class="atw-msg" data-msg="profile" role="status"></p>
      </form>

      <h2>我的认领</h2>
      <div data-claims><p class="atw-empty">还没有认领记录。</p></div>

      <h2>改密码</h2>
      <form class="atw-form" data-form="password">
        <label>
          <span>当前密码</span>
          <input name="currentPassword" type="password" autocomplete="current-password" required />
        </label>
        <label>
          <span>新密码<i>8 位以上；改完其它设备会被踢下线</i></span>
          <input name="newPassword" type="password" autocomplete="new-password" required minlength="8" />
        </label>
        <button class="atw-primary" type="submit">更新密码</button>
        <p class="atw-msg" data-msg="password" role="status"></p>
      </form>
    </section>
  </div>
</BaseLayout>

<script>
  import {
    api,
    cacheUser,
    clearSession,
    escapeHtml,
    formatDate,
    getCachedUser,
    getToken,
    refreshUser,
    setSession,
    url,
    TASK_STATUS_LABEL,
  } from '../../scripts/account-core.js';

  const CLAIM_LABEL = {
    pending: '等发布方定人',
    accepted: '已定给你',
    rejected: '没选上',
    withdrawn: '你已撤回',
  };

  const views = {
    loading: document.querySelector('[data-view="loading"]'),
    anonymous: document.querySelector('[data-view="anonymous"]'),
    'signed-in': document.querySelector('[data-view="signed-in"]'),
  };

  function show(name) {
    for (const [key, node] of Object.entries(views)) node.hidden = key !== name;
  }

  function say(key, text, ok = false) {
    const node = document.querySelector(`[data-msg="${key}"]`);
    node.textContent = text;
    node.dataset.tone = ok ? 'ok' : text ? 'error' : '';
  }

  function fields(form) {
    return Object.fromEntries(new FormData(form).entries());
  }

  // ---------- 未登录 ----------

  document.querySelectorAll('[data-tab]').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('[data-tab]').forEach((t) => t.classList.toggle('is-active', t === tab));
      document.querySelectorAll('[data-form="login"], [data-form="register"]').forEach((form) => {
        form.hidden = form.dataset.form !== tab.dataset.tab;
      });
    });
  });

  document.querySelector('[data-form="login"]').addEventListener('submit', async (event) => {
    event.preventDefault();
    say('login', '登录中…');
    try {
      const payload = await api('POST', '/auth/login', fields(event.target));
      setSession(payload);
      afterSignIn(payload.user);
    } catch (error) {
      say('login', error.message);
    }
  });

  document.querySelector('[data-form="register"]').addEventListener('submit', async (event) => {
    event.preventDefault();
    say('register', '创建中…');
    try {
      const payload = await api('POST', '/auth/register', fields(event.target));
      setSession(payload);
      afterSignIn(payload.user);
    } catch (error) {
      say('register', error.message);
    }
  });

  // ---------- 已登录 ----------

  function renderUser(user) {
    document.querySelector('[data-who-name]').textContent = user.display_name || user.username;
    document.querySelector('[data-who-meta]').textContent =
      `@${user.username} · ${user.email}${user.role === 'admin' ? ' · 发布方' : ''}`;
    document.querySelector('[data-admin-link]').hidden = user.role !== 'admin';
    const form = document.querySelector('[data-form="profile"]');
    form.displayName.value = user.display_name || '';
    form.contact.value = user.contact || '';
    form.payee.value = user.payee || '';
    form.bio.value = user.bio || '';
  }

  function renderClaims(claims) {
    const host = document.querySelector('[data-claims]');
    if (!claims.length) {
      host.innerHTML = '<p class="atw-empty">还没有认领记录。去任务书看看有什么在招。</p>';
      return;
    }
    host.innerHTML = claims
      .map((claim) => {
        const taskUrl = url(`tasks/${claim.taskSlug}/`);
        const note = claim.decideNote ? `<p class="atw-claim-note">发布方留言：${escapeHtml(claim.decideNote)}</p>` : '';
        return `<article class="atw-claim">
          <div class="atw-claim-top">
            <span class="atw-claim-status is-${claim.status}">${CLAIM_LABEL[claim.status] || claim.status}</span>
            <span class="atw-claim-date">${formatDate(claim.createdAt)} 申请</span>
          </div>
          <h3><a href="${taskUrl}">${escapeHtml(claim.taskTitle || claim.taskSlug)}</a></h3>
          <p class="atw-claim-meta">
            任务当前：${TASK_STATUS_LABEL[claim.taskStatus] || claim.taskStatus}
            ${claim.taskFee ? ` · ${escapeHtml(claim.taskFee)}` : ''}
          </p>
          ${note}
        </article>`;
      })
      .join('');
  }

  document.querySelector('[data-form="profile"]').addEventListener('submit', async (event) => {
    event.preventDefault();
    say('profile', '保存中…');
    try {
      const { user } = await api('PATCH', '/profile', fields(event.target));
      cacheUser(user);
      renderUser(user);
      say('profile', '已保存', true);
    } catch (error) {
      say('profile', error.message);
    }
  });

  document.querySelector('[data-form="password"]').addEventListener('submit', async (event) => {
    event.preventDefault();
    say('password', '更新中…');
    try {
      await api('POST', '/auth/password', fields(event.target));
      event.target.reset();
      say('password', '密码已更新，其它设备已退出', true);
    } catch (error) {
      say('password', error.message);
    }
  });

  document.querySelector('[data-logout]').addEventListener('click', async () => {
    try {
      await api('POST', '/auth/logout');
    } catch {
      /* 服务端不认这个会话也无妨，本地照样清干净 */
    }
    clearSession();
    show('anonymous');
  });

  async function afterSignIn(user) {
    renderUser(user);
    show('signed-in');
    // 登录前如果是从某份任务书跳过来的，登录完送回去接着认领
    const back = new URLSearchParams(location.search).get('next');
    if (back && back.startsWith('/')) {
      location.href = back;
      return;
    }
    try {
      const { claims } = await api('GET', '/my/claims');
      renderClaims(claims);
    } catch {
      /* 认领列表拉不到不影响主流程 */
    }
  }

  async function boot() {
    // 注册是否需要邀请码，由服务端说了算
    api('GET', '/meta')
      .then((meta) => {
        document.querySelector('[data-invite]').hidden = !meta.requiresInvite;
        if (meta.requiresInvite) {
          document.querySelector('[data-form="register"] [name="inviteCode"]').required = true;
        }
      })
      .catch(() => {});

    if (!getToken()) {
      show('anonymous');
      return;
    }
    const cached = getCachedUser();
    if (cached) {
      renderUser(cached);
      show('signed-in');
    }
    const user = await refreshUser();
    if (!user) {
      show('anonymous');
      return;
    }
    renderUser(user);
    show('signed-in');
    try {
      const { claims } = await api('GET', '/my/claims');
      renderClaims(claims);
    } catch {
      /* 同上 */
    }
  }

  boot();
</script>

<style>
  .account-page { max-width: 42rem; margin: 0 auto; padding: 3rem 1.5rem 5rem; }

  .masthead { border-bottom: 2px solid var(--ink); padding-bottom: 1.4rem; margin-bottom: 2rem; }
  .masthead-kicker {
    font-size: .7rem; letter-spacing: .22em; text-transform: uppercase;
    color: var(--accent); margin: 0 0 .5rem;
  }
  .masthead h1 { font-family: var(--serif); font-size: clamp(2rem, 6vw, 2.8rem); margin: 0 0 .6rem; }
  .masthead-desc { margin: 0; color: var(--ink-soft); font-size: .92rem; }

  .loading { color: var(--ink-soft); font-size: .9rem; }

  .panel h2 {
    font-family: var(--serif); font-size: 1.2rem; margin: 2.6rem 0 .4rem;
    padding-bottom: .4rem; border-bottom: 1px solid var(--line);
  }
  .section-note { color: var(--ink-soft); font-size: .84rem; margin: .6rem 0 1rem; }

  .tabs { display: flex; gap: .4rem; margin-bottom: 1.4rem; }
  .tab {
    font: inherit; font-size: .88rem; cursor: pointer;
    padding: .4rem 1rem; border-radius: 999px;
    border: 1px solid var(--line); background: transparent; color: var(--ink-soft);
  }
  .tab.is-active { border-color: var(--accent); background: var(--accent-soft); color: var(--accent); }

  .whoami {
    display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between;
    padding: 1rem 1.1rem; border: 1px solid var(--line); border-radius: .6rem; background: var(--paper-2);
  }
  .who-name { margin: 0; font-family: var(--serif); font-size: 1.25rem; }
  .who-meta { margin: .2rem 0 0; font-size: .8rem; color: var(--ink-soft); }
  .who-actions { display: flex; gap: .5rem; }
</style>
