---
// 管理台首页：只回答「现在有什么在等我」，具体操作各自成页。
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="概览" current="home">
  <section class="ad-block">
    <h2>眼下的活</h2>
    <p class="ad-note">数字点得动，直接跳到对应板块。</p>
    <div class="ad-stats" data-stats><p class="atw-empty">加载中…</p></div>
  </section>

  <section class="ad-block">
    <h2>最近的申请</h2>
    <div data-recent><p class="atw-empty">加载中…</p></div>
  </section>
</AdminLayout>

<script>
  import { escapeHtml, formatDate, url } from '../../scripts/account-core.js';
  import { bootAdmin, loadOverview, say, taskHref } from '../../scripts/admin-core.js';

  function renderStats({ tasks, pendingClaims }) {
    const count = (status) => tasks.filter((t) => t.listed && t.status === status).length;
    const stats = [
      { n: pendingClaims.length, label: '待处理申请', href: 'admin/claims/', hot: pendingClaims.length > 0 },
      { n: count('open'), label: '招募中', href: 'admin/tasks/' },
      { n: count('taken'), label: '进行中', href: 'admin/tasks/' },
      { n: count('done'), label: '完工待打款', href: 'admin/tasks/', hot: count('done') > 0 },
    ];
    document.querySelector('[data-stats]').innerHTML = stats
      .map(
        (s) => `<a class="ad-stat${s.hot ? ' is-hot' : ''}" href="${url(s.href)}">
          <b>${s.n}</b><span>${s.label}</span>
        </a>`,
      )
      .join('');
  }

  function renderRecent({ pendingClaims, tasks }) {
    const host = document.querySelector('[data-recent]');
    if (!pendingClaims.length) {
      host.innerHTML = '<p class="atw-empty">没有待处理的申请。</p>';
      return;
    }
    const bySlug = Object.fromEntries(tasks.map((t) => [t.slug, t]));
    host.innerHTML = `${pendingClaims
      .slice(0, 5)
      .map(
        (c) => `<article class="ad-claim">
          <div class="ad-claim-head">
            <a href="${taskHref(bySlug[c.taskSlug] || { slug: c.taskSlug, source: 'md' })}">${escapeHtml(
              c.taskTitle || c.taskSlug,
            )}</a>
            <span class="ad-claim-date">${formatDate(c.createdAt)}</span>
          </div>
          <p class="ad-claim-who"><b>${escapeHtml(c.user)}</b> @${escapeHtml(c.username)}</p>
        </article>`,
      )
      .join('')}<p class="ad-note">去<a href="${url('admin/claims/')}">待处理申请</a>里定人。</p>`;
  }

  async function boot() {
    if (!(await bootAdmin())) return;
    try {
      const overview = await loadOverview();
      renderStats(overview);
      renderRecent(overview);
    } catch (error) {
      say(error.message);
    }
  }

  boot();
</script>
