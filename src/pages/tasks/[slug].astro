---
// 任务书详情页：正文走 .prose 排版，头部集中展示状态 / 报酬 / 截止时间。
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/news.mjs';

export async function getStaticPaths() {
  const tasks = await getCollection('tasks');
  return tasks.map((task) => ({ params: { slug: task.id }, props: { task } }));
}

const { task } = Astro.props;
const { Content } = await render(task);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isOpen = task.data.status === 'open';
const isTaken = task.data.status === 'taken';
const statusLabel = isOpen
  ? '招募中'
  : isTaken
    ? `进行中${task.data.taker ? ` · ${task.data.taker}` : ''}`
    : task.data.status === 'done' ? '完工待打款' : '已收官';
---

<BaseLayout title={task.data.title} description={task.data.summary}>
  {/* 正文来自 markdown（构建期）；状态、认领、流转记录由 task-detail.js 运行时接管 */}
  <article class="prose task-prose" data-task-detail data-slug={task.id}>
    <p class="crumb"><a href={`${base}/tasks/`}>任务书</a> / <span data-crumb-status>{statusLabel}</span></p>
    <h1>{task.data.title}</h1>
    <div class="task-meta">
      <span
        class:list={['tm-status', { 'is-open': isOpen, 'is-taken': isTaken }]}
        data-status-label
      >{statusLabel}</span>
      {/* 报酬可能被发布方在站内调过（报销、加急费），运行时以数据库为准，见 task-detail.js */}
      <span class="tm-item" data-meta-fee hidden={!task.data.fee}>报酬 <b>{task.data.fee}</b></span>
      {task.data.deadline && <span class="tm-item">截止 <b>{formatDate(task.data.deadline)}</b></span>}
      <span class="tm-item">发布 <b>{formatDate(task.data.date)}</b></span>
    </div>
    <p class="fee-note" data-fee-note hidden></p>
    {/* 成稿链接：md 里的 deliverable 只是初值，运行时以数据库为准——
        承接人在站内提交的、或发布方在管理台填的那一条，见 task-detail.js */}
    <p class="task-deliverable" data-deliverable hidden={!task.data.deliverable}>
      <b>成稿</b>
      <a data-deliverable-link href={task.data.deliverable ?? '#'} target="_blank" rel="noopener">读成稿 →</a>
    </p>
    <Content />

    <section class="claim-panel" data-claim-panel hidden></section>
    <section class="timeline" data-timeline hidden></section>

    <p class="back"><a href={`${base}/tasks/`}>← 返回全部任务书</a></p>
  </article>
</BaseLayout>

<script>
  import { hydrateTaskDetail } from '../../scripts/task-detail.js';
  hydrateTaskDetail();
</script>

{/* 头部样式在 global.css（.task-prose 一段）：和站内新建的详情页共用一套 */}
