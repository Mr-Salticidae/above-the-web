---
// 任务书 · Commissions —— 对外发布的合作任务版块。
// 三个分组（招募中 / 进行中 / 已收官）的 DOM 结构一致，卡片能在组间原样搬运：
// 构建时按 markdown 的 status 就位，页面加载后由 tasks-live.js 按数据库的真实状态重排。
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/news.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tasks = (await getCollection('tasks')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const GROUP_OF = { open: 'open', taken: 'taken', done: 'archive', closed: 'archive' };
const groups = {
  open: tasks.filter((t) => GROUP_OF[t.data.status] === 'open'),
  taken: tasks.filter((t) => GROUP_OF[t.data.status] === 'taken'),
  archive: tasks.filter((t) => GROUP_OF[t.data.status] === 'archive'),
};
const statusLabel = (s, taker) =>
  s === 'open' ? '招募中'
  : s === 'taken' ? `进行中${taker ? ` · ${taker}` : ''}`
  : s === 'done' ? '完工待打款'
  : '已收官';
// 教程类标杆：任务书 frontmatter 里写了 exemplar 的成稿，单独成板块供后续任务对标
const exemplars = tasks.filter((t) => t.data.exemplar && t.data.deliverable);
---

<BaseLayout
  title="任务书"
  description="对外发布的合作任务：明确的要求、对标素材、时间与报酬，认领前一次看清。"
>
  <div class="tasks-page">
    <header class="masthead">
      <p class="masthead-kicker">Open Commissions</p>
      <h1>任务书</h1>
      <p class="masthead-sub">Commissions</p>
      <p class="masthead-desc">
        对外发布的合作任务。每份任务书把要求、对标素材、时间与报酬一次写清——认领前先读完，
        做起来才不返工。
      </p>
      <p class="masthead-spec">
        教程类任务另有统一的交付格式标准：<a href={`${base}/tasks/spec/`}>教程类任务规范 →</a>
        {exemplars.length > 0 && (
          <Fragment><span class="ms-sep">·</span><a href="#benchmark">教程类标杆 ↓</a></Fragment>
        )}
      </p>
      <p class="masthead-login">认领任务需要登录（要对接人和打款）；只读站的话不用管账号。</p>
    </header>

    <section class="group open-group" data-group="open" hidden={groups.open.length === 0}>
      <div class="group-list" data-group-list>
        {groups.open.map((t) => (
          <a
            class="task-card"
            href={`${base}/tasks/${t.id}/`}
            data-task-card
            data-slug={t.id}
            data-status={t.data.status}
            data-date={t.data.date}
          >
            <div class="tc-top">
              <span class={`tc-status is-${t.data.status}`} data-status-label>
                {statusLabel(t.data.status, t.data.taker)}
              </span>
              <span class="tc-date">{formatDate(t.data.date)} 发布</span>
            </div>
            <h2>{t.data.title}</h2>
            <p class="tc-summary">{t.data.summary}</p>
            <div class="tc-meta">
              {t.data.fee && <span class="tc-fee">{t.data.fee}</span>}
              {t.data.deadline && <span class="tc-deadline">截止 {formatDate(t.data.deadline)}</span>}
              <span class="tc-queue" data-queue hidden></span>
              <span class="tc-cta">查看任务书 →</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <div class="empty-state" data-empty-open hidden={groups.open.length > 0}>
      <div class="es-mark" aria-hidden="true">🕸️</div>
      <p class="es-title">当前暂无招募中的任务</p>
      <p class="es-sub">新任务书会第一时间发布在这里。想先了解合作方式，可以读读教程类任务的交付标准。</p>
      <a class="es-link" href={`${base}/tasks/spec/`}>教程类任务规范 →</a>
    </div>

    {exemplars.length > 0 && (
      <section class="benchmark" id="benchmark">
        <h2 class="bm-label">教程类标杆 <span>Benchmark</span></h2>
        <p class="bm-intro">
          往期交付中完成度最高的成稿，经发布方评定收录。接同类任务前先通读一遍——
          规范写的是底线，这里是目标。
        </p>
        <div class="bm-list">
          {exemplars.map((t) => (
            <article class="bm-card">
              <div class="bm-top">
                <span class="bm-badge">教程类标杆</span>
                <span class="bm-kind">{t.data.exemplar}</span>
              </div>
              <h3>{t.data.title}</h3>
              <p class="bm-by">
                {t.data.taker && <b>{t.data.taker}</b>}
                {t.data.taker && t.data.delivered && ' 交付 · '}
                {t.data.delivered && formatDate(t.data.delivered)}
              </p>
              {t.data.exemplar_note && <p class="bm-note">{t.data.exemplar_note}</p>}
              <div class="bm-links">
                <a class="bm-main" href={t.data.deliverable} target="_blank" rel="noopener">读成稿 →</a>
                <a class="bm-sub" href={`${base}/tasks/${t.id}/`}>对应任务书</a>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="group inprogress" data-group="taken" hidden={groups.taken.length === 0}>
      <h2 class="group-label">进行中 <span>In Progress</span></h2>
      <div class="group-list" data-group-list>
        {groups.taken.map((t) => (
          <a
            class="task-card is-taken"
            href={`${base}/tasks/${t.id}/`}
            data-task-card
            data-slug={t.id}
            data-status={t.data.status}
            data-date={t.data.date}
          >
            <div class="tc-top">
              <span class={`tc-status is-${t.data.status}`} data-status-label>
                {statusLabel(t.data.status, t.data.taker)}
              </span>
              <span class="tc-date">{formatDate(t.data.date)} 发布</span>
            </div>
            <h2>{t.data.title}</h2>
            <p class="tc-summary">{t.data.summary}</p>
            <div class="tc-meta">
              {t.data.fee && <span class="tc-fee">{t.data.fee}</span>}
              {t.data.deadline && <span class="tc-deadline">截止 {formatDate(t.data.deadline)}</span>}
              <span class="tc-queue" data-queue hidden></span>
              <span class="tc-cta">查看任务书 →</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="group archive" data-group="archive" hidden={groups.archive.length === 0}>
      <h2 class="group-label">已收官 <span>Archive</span></h2>
      <div class="group-list" data-group-list>
        {groups.archive.map((t) => (
          <a
            class="task-card"
            href={`${base}/tasks/${t.id}/`}
            data-task-card
            data-slug={t.id}
            data-status={t.data.status}
            data-date={t.data.date}
          >
            <div class="tc-top">
              <span class={`tc-status is-${t.data.status}`} data-status-label>
                {statusLabel(t.data.status, t.data.taker)}
              </span>
              <span class="tc-date">{formatDate(t.data.date)} 发布</span>
            </div>
            <h2>{t.data.title}</h2>
            <p class="tc-summary">{t.data.summary}</p>
            <div class="tc-meta">
              {t.data.fee && <span class="tc-fee">{t.data.fee}</span>}
              {t.data.deadline && <span class="tc-deadline">截止 {formatDate(t.data.deadline)}</span>}
              <span class="tc-queue" data-queue hidden></span>
              <span class="tc-cta">查看任务书 →</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { hydrateTaskList } from '../../scripts/tasks-live.js';
  hydrateTaskList();
</script>

<style>
  .tasks-page { max-width: 52rem; margin: 0 auto; padding: 3.2rem 1.5rem 6rem; }

  /* 刊头：沿用快讯的杂志封面式排印 */
  .masthead { text-align: center; padding: 0 0 2.6rem; margin: 0 0 2.6rem; border-bottom: 2px solid var(--ink); }
  .masthead-kicker {
    margin: 0 0 .8rem; font-family: var(--sans); font-size: .7rem;
    letter-spacing: .34em; text-transform: uppercase; color: var(--ink-soft);
  }
  .masthead h1 {
    margin: 0; font-family: var(--serif); font-size: clamp(2.6rem, 7vw, 4rem);
    letter-spacing: .1em; line-height: 1.15; color: var(--ink);
    text-shadow: 0 2px 50px rgba(var(--glow), .3);
  }
  .masthead-sub {
    margin: .5rem 0 0; font-family: var(--sans); font-size: .74rem;
    letter-spacing: .52em; text-transform: uppercase; color: var(--accent);
  }
  .masthead-desc {
    margin: 1.3rem auto 0; max-width: 34rem;
    font-size: .92rem; line-height: 1.8; color: var(--ink-soft);
  }
  .masthead-spec {
    margin: .9rem 0 0; font-family: var(--sans); font-size: .86rem; color: var(--ink-soft);
  }
  .masthead-spec a { font-weight: 600; color: var(--accent); }
  .masthead-login { margin: .5rem 0 0; font-family: var(--sans); font-size: .78rem; color: var(--ink-soft); opacity: .85; }
  .ms-sep { margin: 0 .5em; opacity: .55; }

  /* 教程类标杆：往期最好的成稿单独陈列，视觉上比任务卡片更「样板」——描边与底色都走 accent */
  .benchmark { margin: 0 0 3.4rem; }
  .bm-label {
    display: flex; align-items: baseline; gap: .55rem;
    font-family: var(--serif); font-size: 1.05rem; margin: 0 0 .6rem;
    padding-top: .85rem; border-top: 2px solid var(--ink); color: var(--ink);
  }
  .bm-label span {
    font-family: var(--sans); font-weight: 400; font-size: .68rem;
    letter-spacing: .26em; text-transform: uppercase; color: var(--accent);
  }
  .bm-intro { margin: 0 0 1.2rem; max-width: 38rem; font-size: .9rem; line-height: 1.8; color: var(--ink-soft); }
  .bm-list { display: flex; flex-direction: column; gap: 1.1rem; }
  .bm-card {
    padding: 1.4rem 1.6rem 1.5rem; border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--accent) 42%, var(--line));
    background: var(--accent-soft);
  }
  .bm-top { display: flex; flex-wrap: wrap; align-items: baseline; gap: .7rem; margin-bottom: .6rem; }
  .bm-badge {
    font-family: var(--sans); font-size: .66rem; letter-spacing: .14em;
    border-radius: 999px; padding: .22em .8em; white-space: nowrap;
    color: var(--paper); background: var(--accent);
  }
  .bm-kind { font-family: var(--sans); font-size: .76rem; letter-spacing: .06em; color: var(--ink-soft); }
  .bm-card h3 { font-family: var(--serif); font-size: 1.3rem; line-height: 1.5; margin: 0 0 .3rem; color: var(--ink); }
  .bm-by { margin: 0 0 .7rem; font-family: var(--sans); font-size: .8rem; color: var(--ink-soft); }
  .bm-by b { color: var(--ink); font-weight: 600; }
  .bm-note { margin: 0 0 1rem; font-size: .92rem; line-height: 1.8; color: var(--ink-soft); }
  .bm-links { display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem 1.3rem; }
  .bm-main { font-family: var(--sans); font-size: .9rem; font-weight: 600; color: var(--accent); }
  .bm-sub { font-family: var(--sans); font-size: .84rem; color: var(--ink-soft); }

  .group { margin: 0 0 3.4rem; }
  .group-list { display: flex; flex-direction: column; gap: 1.1rem; }
  .group-label {
    display: flex; align-items: baseline; gap: .55rem;
    font-family: var(--serif); font-size: 1.05rem; margin: 0 0 1rem;
    padding-top: .85rem; border-top: 2px solid var(--ink); color: var(--ink);
  }
  .group-label span {
    font-family: var(--sans); font-weight: 400; font-size: .68rem;
    letter-spacing: .26em; text-transform: uppercase; color: var(--ink-soft);
  }

  /* 空状态：没有招募中任务时，给一个成型的卡片而非悬空文字 */
  .empty-state {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    gap: .55rem; margin: 0 0 3.4rem; padding: 3rem 1.5rem;
    border: 1px dashed color-mix(in srgb, var(--accent) 32%, var(--line));
    border-radius: 16px; background: var(--paper-2);
  }
  .es-mark {
    font-size: 2rem; line-height: 1; margin-bottom: .3rem;
    filter: grayscale(.15); opacity: .9;
  }
  .es-title { margin: 0; font-family: var(--serif); font-size: 1.2rem; color: var(--ink); }
  .es-sub { margin: 0; max-width: 30rem; font-size: .9rem; line-height: 1.75; color: var(--ink-soft); }
  .es-link { margin-top: .5rem; font-family: var(--sans); font-size: .88rem; font-weight: 600; color: var(--accent); }

  /* 已收官分组把卡片压成细线目录体，容器这一句留在页面里；
     卡片本体（.task-card / .tc-*，含归档态）在 global.css——
     站内新建的任务卡片由 tasks-live.js 运行时拼出来，作用域化的样式套不上它。 */
  .archive .group-list { gap: 0; }
</style>
