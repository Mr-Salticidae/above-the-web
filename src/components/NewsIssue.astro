---
// 单期 AIGC 快讯的杂志式渲染：刊眉行 + 当日提要 + 主栏头条 + 窄栏速览。
// 无卡片、无圆角、无投影——分隔靠发丝线，层级靠字号、字距与留白。
// 供 /news/ 首页（最新一期）与 /news/[date]/（归档单期）复用。
import { formatDate } from '../lib/news.mjs';

const CAT_EN = { 模型: 'MODELS', 工具: 'TOOLS', 行业: 'INDUSTRY', 研究: 'RESEARCH', 政策: 'POLICY' };

const { issue } = Astro.props;
const featured = issue.items.filter((i) => i.featured);
const briefs = issue.items.filter((i) => !i.featured);
const sources = new Set(issue.items.map((i) => i.source)).size;
const cats = new Set(issue.items.map((i) => i.category)).size;
---

<article class="issue">
  <p class="issue-folio">
    <b>第 {issue.no} 期</b><i>·</i>{formatDate(issue.date)}<i>·</i>{issue.items.length} 条<i>·</i>来源 {sources} 家<i>·</i>{cats} 个分类
  </p>

  {issue.headline && <p class="issue-deck">{issue.headline}</p>}

  <div class="issue-grid">
    <div class="issue-main">
      {featured.length > 0 && <h3 class="block-label">头条 <span>Top Stories</span></h3>}
      {featured.map((it, i) => (
        <div class:list={['story', { 'is-lead': i === 0 }]} data-cat={it.category}>
          <div class="st-meta">
            <p class="st-cat">{it.category}<em>{CAT_EN[it.category] || ''}</em></p>
            <p class="st-credit">{it.source} ↗</p>
          </div>
          <h4 class="st-title"><a href={it.url} target="_blank" rel="noopener">{it.title}</a></h4>
          <p class="st-body">{it.summary}</p>
        </div>
      ))}
    </div>

    {briefs.length > 0 && (
      <aside class="issue-rail">
        <h3 class="block-label">速览 <span>In Brief</span></h3>
        <ol class="brief-list">
          {briefs.map((it, i) => (
            <li data-cat={it.category}>
              <span class="rb-no">{String(i + 1).padStart(2, '0')}</span>
              <a href={it.url} target="_blank" rel="noopener">
                <p class="rb-cat">{it.category}</p>
                <h4 class="rb-title">{it.title}</h4>
                <p class="rb-sum">{it.summary}</p>
                <p class="rb-src">{it.source} ↗</p>
              </a>
            </li>
          ))}
        </ol>
      </aside>
    )}
  </div>
</article>

<style>
  /* 刊眉行：一条 1px 发丝线与一条 2px 墨线夹住本期元信息 */
  .issue-folio {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline;
    gap: 0 .7rem; margin: 1.15rem 0 0; padding: .55rem 0;
    border-top: 1px solid var(--line); border-bottom: 2px solid var(--ink);
    font-family: var(--sans); font-size: .74rem; letter-spacing: .12em;
    color: var(--ink-soft); font-variant-numeric: tabular-nums;
  }
  .issue-folio b { font-weight: 600; color: var(--accent); }
  .issue-folio i { font-style: normal; opacity: .5; }

  /* 当日提要（standfirst）：居中大字衬线 */
  .issue-deck {
    max-width: 43rem; margin: 2.1rem auto 0;
    font-family: var(--serif); font-size: clamp(1.35rem, 2.7vw, 1.9rem);
    line-height: 1.5; text-align: center; text-wrap: pretty; color: var(--ink);
  }

  /* 栏题：标签 + 一条延伸到栏宽的发丝线 */
  .block-label {
    display: flex; align-items: baseline; gap: .6rem; margin: 0 0 .2rem;
    font-family: var(--serif); font-size: 1.02rem; font-weight: 700;
    letter-spacing: .08em; color: var(--ink);
  }
  .block-label span {
    font-family: var(--sans); font-weight: 400; font-size: .63rem;
    letter-spacing: .24em; text-transform: uppercase; color: var(--ink-soft);
  }
  .block-label::after { content: ""; flex: 1; height: 1px; background: var(--line); }

  /* 分类色：中间调色相，昼夜皮肤下均可读 */
  [data-cat="模型"] { --cat: var(--accent); }
  [data-cat="工具"] { --cat: #0e9f8a; }
  [data-cat="行业"] { --cat: #d97a16; }
  [data-cat="研究"] { --cat: #2f7fd4; }
  [data-cat="政策"] { --cat: #c9484f; }

  /* 主栏（头条）+ 窄栏（速览），中间一条发丝线 */
  .issue-grid {
    display: grid; grid-template-columns: minmax(0, 1.62fr) minmax(15rem, 1fr);
    margin-top: 2.4rem;
  }
  .issue-main { padding-right: 2.6rem; }
  .issue-rail { border-left: 1px solid var(--line); padding-left: 2.6rem; }

  /* 头条：分类与来源排在标题左侧页边 */
  .story {
    display: grid; grid-template-columns: 5.75rem 1fr; column-gap: 1.75rem;
    padding: 1.6rem 0 1.9rem; border-top: 1px solid var(--line);
  }
  .story:first-of-type { border-top: 0; padding-top: 1.1rem; }
  .st-meta { grid-column: 1; text-align: right; }
  .st-cat {
    margin: 0; font-family: var(--sans); font-size: .7rem; font-weight: 600;
    letter-spacing: .14em; color: var(--cat, var(--accent));
  }
  .st-cat em {
    display: block; margin-top: .3rem; font-style: normal;
    font-size: .58rem; letter-spacing: .2em; color: var(--ink-soft);
  }
  .st-credit {
    margin: .8rem 0 0; padding-top: .55rem; border-top: 1px solid var(--line);
    font-family: var(--sans); font-size: .72rem; line-height: 1.5;
    letter-spacing: .04em; color: var(--ink-soft);
  }
  .st-title {
    grid-column: 2; margin: 0; font-family: var(--serif);
    font-size: clamp(1.4rem, 2.4vw, 1.78rem); line-height: 1.3;
    letter-spacing: .005em; text-wrap: pretty;
  }
  .story.is-lead .st-title { font-size: clamp(1.95rem, 3.6vw, 2.55rem); line-height: 1.22; }
  .st-title a { color: var(--ink); }
  .st-title a:hover {
    color: var(--cat, var(--accent)); text-decoration: underline;
    text-decoration-thickness: 1px; text-underline-offset: .22em;
  }
  .st-body {
    grid-column: 2; margin: .9rem 0 0; max-width: 34rem;
    font-size: 1rem; line-height: 1.85; color: var(--ink-soft);
  }

  /* 速览：两位序号 + 标题 + 摘要 + 来源 */
  .brief-list { list-style: none; margin: .9rem 0 0; padding: 0; }
  .brief-list li {
    display: grid; grid-template-columns: 2.1rem 1fr; column-gap: .85rem;
    padding: 1rem 0; border-top: 1px solid var(--line);
  }
  .brief-list li:first-child { border-top: 0; padding-top: .5rem; }
  .brief-list a { display: block; color: var(--ink); }
  .brief-list a:hover { text-decoration: none; }
  .rb-no {
    font-family: var(--serif); font-size: 1.05rem; line-height: 1.45;
    color: var(--cat, var(--accent)); font-variant-numeric: tabular-nums;
  }
  .rb-cat {
    margin: 0 0 .32rem; font-family: var(--sans); font-size: .63rem;
    font-weight: 600; letter-spacing: .18em; color: var(--cat, var(--accent));
  }
  .rb-title { margin: 0; font-family: var(--serif); font-size: 1.02rem; line-height: 1.5; font-weight: 700; }
  .brief-list a:hover .rb-title {
    color: var(--cat, var(--accent)); text-decoration: underline;
    text-decoration-thickness: 1px; text-underline-offset: .2em;
  }
  .rb-sum { margin: .42rem 0 0; font-size: .85rem; line-height: 1.7; color: var(--ink-soft); }
  .rb-src { margin: .48rem 0 0; font-family: var(--sans); font-size: .7rem; letter-spacing: .05em; color: var(--ink-soft); }

  @media (max-width: 900px) {
    .issue-grid { grid-template-columns: 1fr; }
    .issue-main { padding-right: 0; }
    .issue-rail {
      border-left: 0; padding-left: 0; margin-top: 2.6rem;
      border-top: 2px solid var(--ink); padding-top: 1.1rem;
    }
  }
  @media (max-width: 620px) {
    .story { grid-template-columns: 1fr; }
    .st-meta { text-align: left; display: flex; align-items: baseline; gap: .9rem; margin-bottom: .6rem; }
    .st-cat em { display: inline; margin: 0 0 0 .5rem; }
    .st-credit { margin: 0; padding: 0; border: 0; }
    .st-title, .st-body { grid-column: 1; }
  }
</style>
