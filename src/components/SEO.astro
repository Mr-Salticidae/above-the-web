---
// 页头的「分发层」：规范地址、Open Graph / Twitter 卡片、JSON-LD、Feed 自动发现、PWA manifest。
//
// 只在主站与 Pages 镜像构建里渲染。快讯子站 / Toy 包（STANDALONE）一概不出：
// 这里每一行几乎都带主站绝对地址，进了子站就破坏它的对外隔离（见 scripts/build-news-site.mjs 的守卫），
// 进了 Toy 包则指向包里不存在的文件。
import { CANONICAL_ORIGIN, SITE_NAME, SITE_LANG, STANDALONE, canonicalUrl, stripBase } from '../lib/site.mjs';
import { graph, serializeLd } from '../lib/structured-data.mjs';

const {
  title,
  description,
  canonical,
  noindex = false,
  type = 'website',
  image,
  article,
  ld = [],
} = Astro.props;

const base = import.meta.env.BASE_URL;
// 未显式指定时，规范地址 = 主站同路径；Pages 镜像上的每一页因此都回指主站
const canonicalHref = canonical || canonicalUrl(stripBase(Astro.url.pathname, base));
const ogImage = image
  ? (/^https?:/.test(image) ? image : `${CANONICAL_ORIGIN}/${String(image).replace(/^\/+/, '')}`)
  : `${CANONICAL_ORIGIN}/og-default.png`;
const ogLocale = SITE_LANG.replace('-', '_');
const feeds = [
  { href: `${base}rss.xml`, type: 'application/rss+xml', title: `${SITE_NAME} · 全站更新` },
  { href: `${base}notes/rss.xml`, type: 'application/rss+xml', title: `${SITE_NAME} · 笔记` },
  { href: `${base}news/rss.xml`, type: 'application/rss+xml', title: `${SITE_NAME} · AIGC 快讯` },
  { href: `${base}feed.json`, type: 'application/feed+json', title: `${SITE_NAME} · 全站更新（JSON Feed）` },
];
---

{!STANDALONE && (
  <>
    {!noindex && <link rel="canonical" href={canonicalHref} />}
    <meta name="author" content="跳蛛先生" />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    {type === 'article' && article?.published && <meta property="article:published_time" content={article.published} />}
    {type === 'article' && article?.updated && <meta property="article:modified_time" content={article.updated} />}
    {type === 'article' && article?.section && <meta property="article:section" content={article.section} />}
    {type === 'article' && (article?.tags || []).map((t) => <meta property="article:tag" content={t} />)}

    {feeds.map((f) => <link rel="alternate" type={f.type} title={f.title} href={f.href} />)}
    <link rel="sitemap" type="application/xml" href={`${base}sitemap.xml`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />

    {!noindex && <script type="application/ld+json" set:html={serializeLd(graph(ld))} />}
  </>
)}
