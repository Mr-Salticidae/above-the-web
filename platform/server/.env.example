# 复制为 .env 后按实际值填写。.env 不进 git。

ATW_MODE=production
ATW_HOST=127.0.0.1
ATW_PORT=3200

# SQLite 数据文件（生产放 /var/lib/atw-platform/atw.sqlite）
ATW_DB_PATH=/var/lib/atw-platform/atw.sqlite

# 允许携带凭证的来源，逗号分隔。主站与 API 同域，跨域只发生在 Pages 镜像上。
ATW_CORS_ORIGINS=https://tiaozhuxiansheng.com,https://www.tiaozhuxiansheng.com,https://mr-salticidae.github.io

# 会话有效期（小时），默认 720 = 30 天
ATW_SESSION_HOURS=720

# 开放注册：读站不需要账号，只有认领任务要登录。被刷号时改成 false 临时收口。
ATW_REGISTRATION_OPEN=true
# 平时留空。填了值就是「注册需要邀请码」。
ATW_INVITE_CODE=

# 任务清单：Astro 构建产物，主站部署时随 dist 一起 rsync 上来
ATW_TASKS_MANIFEST=/var/www/tiaozhuxiansheng/tasks/index.json
ATW_TASKS_SYNC_MINUTES=10

# 站点地址：重置密码的链接拼在这上面，必须是用户实际访问的那个域
ATW_SITE_URL=https://tiaozhuxiansheng.com

# 发信（自助重置密码用）。留空 = 没有发信通道，忘记密码自动退回
# 「管理台生成一次性链接、站长人工发」，接口和页面都还在，不会走死。
#
# 顺序不能反：先在 resend.com/domains 加 tiaozhuxiansheng.com 并把 DNS 记录
# 加到阿里云云解析（本域 NS 在 hichina）、等 Verified，再往下面填 key。
# 域名没验证就填 key 的话，页面会说「信已经发出去了」而 Resend 直接 403 —— 比没这功能更糟。
ATW_MAIL_PROVIDER=resend
ATW_MAIL_API_KEY=
# 带显示名要加引号，systemd 读 EnvironmentFile 时会自己去掉
ATW_MAIL_FROM="蛛网之上 <no-reply@tiaozhuxiansheng.com>"
# 用户直接回信时收在哪儿，可留空
ATW_MAIL_REPLY_TO=

# 重置链接有效期（分钟）
ATW_RESET_TTL_MINUTES=60

# 站内 AI 通道：任务书辅助填写 + 知识库对话查询。
# 留空 = 没有 AI 通道：/api/meta 的 aiAssist / knowledgeChat 变 false，页面自动降级到手填与普通搜索。
# 走 OpenAI 兼容协议，换供应商改 BASE_URL / MODEL 即可，前提是对方支持
# response_format.json_schema（不支持的话模型会返回散文，解析不出结构化字段）。
ATW_AI_API_KEY=
ATW_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ATW_AI_MODEL=qwen3.8-max
ATW_AI_TIMEOUT_MS=90000
ATW_AI_MAX_TOKENS=4096
# 每个账号每小时最多叫几次（任务书辅助与知识库查询合并计数）
ATW_AI_HOURLY_LIMIT=30
# 各家自己的参数，原样并进请求体。写坏了当没填，不会让服务起不来。
# 千问默认开思考，填表这种活儿会把额度全烧在 reasoning 上、正文反而写不完
# （2026-08-03 实测：关掉之后 reasoning_tokens 归零，951 token 出完整八小节正文）。
#
# ⚠ 外面这层单引号不能省。systemd 读 EnvironmentFile 只在「整个值被引号包住」时才剥引号，
# 裸写 {"a":false} 它原样保留、看着是对的；但本地开发按 README 那样 `. ./.env` 时，
# POSIX shell 会把里面的双引号吃掉，变成 {a:false}，JSON.parse 失败 → 静默退回 {} →
# 思考没关掉、正文写不完。加上单引号两种读法结果一致（2026-08-03 两边都验过）。
ATW_AI_EXTRA_JSON='{"enable_thinking":false}'

# 首次启动自动创建的管理员（发布方本人）。登录后立刻改密码。
ATW_ADMIN_USERNAME=admin
ATW_ADMIN_DISPLAY_NAME=跳蛛先生
ATW_ADMIN_EMAIL=admin@example.com
ATW_ADMIN_PASSWORD=
