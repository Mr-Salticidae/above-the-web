# 复制为 .env 后按实际值填写。.env 不进 git。

ATW_MODE=production
ATW_HOST=127.0.0.1
ATW_PORT=3200

# SQLite 数据文件（生产放 /var/lib/atw-platform/atw.sqlite）
ATW_DB_PATH=/var/lib/atw-platform/atw.sqlite

# 允许携带凭证的来源，逗号分隔。主站与 API 同域，跨域只发生在 Pages 镜像上。
ATW_CORS_ORIGINS=https://tiaozhuxiansheng.com,https://www.tiaozhuxiansheng.com,https://mr-salticidae.github.io

# 会话有效期（小时），默认 720 = 30 天
ATW_SESSION_HOURS=720

# 开放注册：读站不需要账号，只有认领任务要登录。被刷号时改成 false 临时收口。
ATW_REGISTRATION_OPEN=true
# 平时留空。填了值就是「注册需要邀请码」。
ATW_INVITE_CODE=

# 任务清单：Astro 构建产物，主站部署时随 dist 一起 rsync 上来
ATW_TASKS_MANIFEST=/var/www/tiaozhuxiansheng/tasks/index.json
ATW_TASKS_SYNC_MINUTES=10

# 首次启动自动创建的管理员（发布方本人）。登录后立刻改密码。
ATW_ADMIN_USERNAME=admin
ATW_ADMIN_DISPLAY_NAME=跳蛛先生
ATW_ADMIN_EMAIL=admin@example.com
ATW_ADMIN_PASSWORD=
